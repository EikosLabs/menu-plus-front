---
import LanguageSwitcher from '../components/LanguageSwitcher.jsx';
import { t } from '../i18n/utils';

export interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const { title, description, lang } = Astro.props;

// Obtener idioma desde la URL o usar el idioma proporcionado
function getCurrentLangSSR() {
  if (lang) return lang;
  
  const pathname = Astro.url.pathname;
  const langFromPath = pathname.split('/')[1];
  
  // Verificar si es un idioma válido
  if (['es', 'en'].includes(langFromPath)) {
    return langFromPath;
  }
  
  return 'es'; // idioma por defecto
}

const currentLang = getCurrentLangSSR();

// Textos localizados para el layout
const layoutTitle = title || t('navigation.home', currentLang);
const layoutDescription = description || t('dashboard.welcome', currentLang);
---

<!DOCTYPE html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={layoutDescription} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={layoutTitle} />
    <meta property="og:description" content={layoutDescription} />
    <meta property="og:locale" content={currentLang === 'es' ? 'es_ES' : 'en_US'} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={layoutTitle} />
    <meta property="twitter:description" content={layoutDescription} />
    
    <!-- Idiomas alternativos -->
    <link rel="alternate" hreflang="es" href={`${Astro.site || ''}${Astro.url.pathname.replace(/^\/en/, '')}`} />
    <link rel="alternate" hreflang="en" href={`${Astro.site || ''}/en${Astro.url.pathname}`} />
    <link rel="alternate" hreflang="x-default" href={`${Astro.site || ''}${Astro.url.pathname.replace(/^\/en/, '')}`} />
    
    <title>{layoutTitle} - MenuPlus</title>
    
    <!-- Configuración inicial del idioma -->
    <script define:vars={{ currentLang }}>
      // Asegurar que el idioma se establezca correctamente antes de la hidratación
      (function() {
        const savedLang = localStorage.getItem('preferred-language');
        const htmlLang = currentLang;
        
        if (savedLang && savedLang !== htmlLang) {
          const currentPath = window.location.pathname;
          const pathSegments = currentPath.split('/').filter(segment => segment);
          
          // Remover idioma actual si existe
          if (['es', 'en'].includes(pathSegments[0])) {
            pathSegments.shift();
          }
          
          // Construir nueva ruta
          let newPath = '';
          if (savedLang !== 'es') {
            newPath = `/${savedLang}`;
          }
          
          if (pathSegments.length > 0) {
            newPath += `/${pathSegments.join('/')}`;
          }
          
          if (!newPath) {
            newPath = '/';
          }
          
          if (newPath !== currentPath) {
            window.location.replace(newPath);
          }
        }
      })();
    </script>
  </head>
  
  <body class="bg-gradient-to-br from-slate-50 to-slate-100 min-h-screen">
    <!-- Header con selector de idioma -->
    <header class="bg-white shadow-sm border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <!-- Logo y título -->
          <div class="flex items-center space-x-3">
            <div class="w-8 h-8 bg-gradient-to-br from-[#E05C33] to-[#FF9B54] rounded-lg flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <h1 class="text-xl font-bold text-[#004E71]">MenuPlus</h1>
          </div>
          
          <!-- Selector de idioma -->
          <div class="flex items-center space-x-4">
            <LanguageSwitcher client:load />
          </div>
        </div>
      </div>
    </header>
    
    <!-- Contenido principal -->
    <main class="flex-1">
      <slot />
    </main>
    
    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
          <div class="text-sm text-slate-600">
            © 2024 MenuPlus. {currentLang === 'es' ? 'Todos los derechos reservados.' : 'All rights reserved.'}
          </div>
          
          <div class="flex items-center space-x-6 text-sm text-slate-600">
            <a href={currentLang === 'es' ? '/ayuda' : '/en/help'} class="hover:text-[#E05C33] transition-colors">
              {currentLang === 'es' ? 'Ayuda' : 'Help'}
            </a>
            <a href={currentLang === 'es' ? '/privacidad' : '/en/privacy'} class="hover:text-[#E05C33] transition-colors">
              {currentLang === 'es' ? 'Privacidad' : 'Privacy'}
            </a>
            <a href={currentLang === 'es' ? '/terminos' : '/en/terms'} class="hover:text-[#E05C33] transition-colors">
              {currentLang === 'es' ? 'Términos' : 'Terms'}
            </a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  html {
    scroll-behavior: smooth;
  }
  
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  
  main {
    flex: 1;
  }
  
  /* Animaciones */
  .animate-fadeIn {
    animation: fadeIn 0.3s ease-in-out;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style> 