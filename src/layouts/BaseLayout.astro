---
import LanguageSwitcher from "../components/LanguageSwitcher.jsx";
import { t, localizeUrl } from "../i18n/utils";
import "../styles/global.css";
import "../sentry.js";

export interface Props {
	title?: string;
	description?: string;
	lang?: string;
}

const { title, description, lang } = Astro.props;

// Obtener idioma desde la URL o usar el idioma proporcionado
function getCurrentLangSSR() {
	if (lang) return lang;

	const pathname = Astro.url.pathname;
	const langFromPath = pathname.split("/")[1];

	// Verificar si es un idioma válido
	if (["es", "en"].includes(langFromPath)) {
		return langFromPath;
	}

	return "es"; // idioma por defecto
}

const currentLang = getCurrentLangSSR();

// Textos localizados para el layout
const layoutTitle = title || t("navigation.home", currentLang);
const layoutDescription = description || t("dashboard.welcome", currentLang);
---

<!DOCTYPE html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={layoutDescription} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={layoutTitle} />
    <meta property="og:description" content={layoutDescription} />
    <meta property="og:locale" content={currentLang === 'es' ? 'es_ES' : 'en_US'} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={layoutTitle} />
    <meta property="twitter:description" content={layoutDescription} />

    <!-- Idiomas alternativos -->
    <link rel="alternate" hreflang="es" href={`${Astro.site || ''}${Astro.url.pathname.replace(/^\/en/, '')}`} />
    <link rel="alternate" hreflang="en" href={`${Astro.site || ''}/en${Astro.url.pathname}`} />
    <link rel="alternate" hreflang="x-default" href={`${Astro.site || ''}${Astro.url.pathname.replace(/^\/en/, '')}`} />

    <!-- Poppins Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;700;900&family=Inter:wght@400;500;700&display=swap" rel="stylesheet">

    <title>{layoutTitle} - MenuPlus</title>

    <!-- Configuración inicial del idioma -->
    <script define:vars={{ currentLang }}>
      // Asegurar que el idioma se establezca correctamente antes de la hidratación
      (function() {
        const savedLang = localStorage.getItem('preferred-language');
        const htmlLang = currentLang;

        if (savedLang && savedLang !== htmlLang) {
          const currentPath = window.location.pathname;
          const pathSegments = currentPath.split('/').filter(segment => segment);

          // Remover idioma actual si existe
          if (['es', 'en'].includes(pathSegments[0])) {
            pathSegments.shift();
          }

          // Construir nueva ruta
          let newPath = '';
          if (savedLang !== 'es') {
            newPath = `/${savedLang}`;
          }

          if (pathSegments.length > 0) {
            newPath += `/${pathSegments.join('/')}`;
          }

          if (!newPath) {
            newPath = '/';
          }

          if (newPath !== currentPath) {
            window.location.replace(newPath);
          }
        }
      })();
    </script>
  </head>

  <body class="bg-neo-lavender min-h-screen font-sans">
    <!-- Header Neobrutalist -->
    <header class="bg-white neo-border-bottom border-b-neo-extra border-neo-black relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20">
          <!-- Logo y título -->
          <div class="flex items-center space-x-3">
            <div class="neo-icon-3d neo-icon-3d-flame w-12 h-12">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <h1 class="neo-heading neo-h3 text-neo-flame mb-0">MenuPlus</h1>
          </div>

          <!-- Selector de idioma -->
          <div class="flex items-center space-x-4">
            <LanguageSwitcher client:load />
          </div>
        </div>
      </div>
    </header>

    <!-- Contenido principal -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer Neobrutalist -->
    <footer class="bg-neo-black text-white border-t-neo-thick border-neo-flame mt-auto py-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
          <div class="neo-text text-white/80">
            © 2024 MenuPlus. {currentLang === 'es' ? 'Todos los derechos reservados.' : 'All rights reserved.'}
          </div>

          <div class="flex items-center space-x-6">
            <a href="mailto:hello@eikoslabs.com" class="neo-text text-white/80 hover:text-neo-sunset transition-colors neo-text-bold">
              hello@eikoslabs.com
            </a>
            <a href={localizeUrl('/help', currentLang)} class="neo-text text-white/80 hover:text-neo-sunset transition-colors neo-text-bold">
              {t('navigation.help', currentLang)}
            </a>
            <a href={localizeUrl('/privacy', currentLang)} class="neo-text text-white/80 hover:text-neo-sunset transition-colors neo-text-bold">
              {t('privacy.title', currentLang) || 'Privacy'}
            </a>
            <a href={localizeUrl('/terms', currentLang)} class="neo-text text-white/80 hover:text-neo-sunset transition-colors neo-text-bold">
              {t('terms.title', currentLang) || 'Terms'}
            </a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    font-family: var(--neo-font-body);
  }

  main {
    flex: 1;
  }
</style>
