---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t } from "../../i18n/utils";

const lang = "en";
---

<BaseLayout 
  title={t('navigation.home', lang)} 
  description={t('dashboard.welcome', lang)}
  lang={lang}
>
  <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
    <!-- Hero Section -->
    <section class="relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
        <div class="text-center">
          <h1 class="text-4xl md:text-6xl font-bold text-[#004E71] mb-6">
            {t('dashboard.welcome', lang)}
            <span class="block text-[#1a1a1a]">MenuPlus</span>
          </h1>
          <p class="text-xl text-slate-600 mb-8 max-w-3xl mx-auto">
            Create and manage digital menus for your business. Share QR codes and attract more customers with our professional platform.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a 
              href="/en/register" 
              class="inline-flex items-center px-8 py-3 bg-[#1a1a1a] hover:bg-[#333333] text-white font-medium rounded-lg shadow-lg transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
              {t('auth.register', lang)}
            </a>
            <a 
              href="/en/login" 
              class="inline-flex items-center px-8 py-3 border-2 border-[#004E71] text-[#004E71] hover:bg-[#004E71] hover:text-white font-medium rounded-lg transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {t('auth.login', lang)}
            </a>
          </div>
        </div>
      </div>
      
      <!-- Background decoration -->
      <div class="absolute inset-0 -z-10">
        <div class="absolute top-20 left-10 w-72 h-72 bg-[#1a1a1a] opacity-10 rounded-full blur-3xl"></div>
        <div class="absolute bottom-20 right-10 w-96 h-96 bg-[#004E71] opacity-10 rounded-full blur-3xl"></div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-[#004E71] mb-4">
            Why choose MenuPlus?
          </h2>
          <p class="text-xl text-slate-600 max-w-2xl mx-auto">
            The complete solution for managing your business's digital menus.
          </p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
          <!-- Feature 1 -->
          <div class="text-center p-6 rounded-xl border border-slate-200 hover:shadow-lg transition-shadow">
            <div class="w-16 h-16 bg-gradient-to-br from-[#1a1a1a] to-[#333333] rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[#004E71] mb-2">Easy to Use</h3>
            <p class="text-slate-600">Intuitive interface to create and manage your menus in minutes.</p>
          </div>
          
          <!-- Feature 2 -->
          <div class="text-center p-6 rounded-xl border border-slate-200 hover:shadow-lg transition-shadow">
            <div class="w-16 h-16 bg-gradient-to-br from-[#1a1a1a] to-[#333333] rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[#004E71] mb-2">QR Codes</h3>
            <p class="text-slate-600">Generate QR codes so your customers can access the menu instantly.</p>
          </div>
          
          <!-- Feature 3 -->
          <div class="text-center p-6 rounded-xl border border-slate-200 hover:shadow-lg transition-shadow">
            <div class="w-16 h-16 bg-gradient-to-br from-[#1a1a1a] to-[#333333] rounded-lg flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[#004E71] mb-2">Images</h3>
            <p class="text-slate-600">Add images to your items to make them more attractive to customers.</p>
          </div>
        </div>
      </div>
    </section>
    
    <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-r from-[#004E71] to-[#0A3342]">
      <div class="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
          Ready to get started?
        </h2>
        <p class="text-xl text-slate-200 mb-8">
          Join thousands of businesses that already use MenuPlus to manage their digital menus.
        </p>
        <a 
          href="/en/register" 
          class="inline-flex items-center px-8 py-4 bg-[#1a1a1a] hover:bg-[#333333] text-white font-medium rounded-lg shadow-lg transition-colors text-lg"
        >
          {t('auth.registerButton', lang)}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </section>
  </div>
</BaseLayout> 