---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n/utils";

// Verificar si el usuario está autenticado
const token = Astro.cookies.get("auth_token")?.value;

// Si el usuario está autenticado, redirigir al dashboard
if (token) {
	return Astro.redirect("/dashboard");
}

const lang = "es";
---

<BaseLayout
  title={t('navigation.home', lang)}
  description={t('dashboard.welcome', lang)}
  lang={lang}
>
  <div class="min-h-screen bg-neo-lavender">
    <!-- Hero Section Ultra -->
    <section class="neo-hero-ultra">
      <div class="neo-container py-24">
        <div class="text-center neo-hero-content relative z-10">
          <!-- Floating Badge -->
          <div class="inline-block neo-sticker neo-sticker-flame mb-8 neo-badge-float">
            ✨ ULTRA ESTÉTICO
          </div>

          <!-- Main Title with Shadow Effect -->
          <h1 class="neo-heading neo-h1 mb-6">
            {t('dashboard.welcome', lang)}
            <span class="block text-neo-flame mt-2 neo-text-shadow">MenuPlus</span>
          </h1>

          <!-- Subtitle -->
          <p class="neo-text neo-text-xl mb-12 text-neo-gray max-w-3xl mx-auto">
            Crea y gestiona menús digitales para tu negocio. Comparte códigos QR y atrae más clientes con nuestra plataforma profesional.
          </p>

          <!-- Super Buttons -->
          <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
            <a
              href="/register"
              class="neo-btn-super"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
              {t('auth.register', lang)}
            </a>
            <a
              href="/login"
              class="neo-btn-super neo-btn-super-sunset"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {t('auth.login', lang)}
            </a>
          </div>

          <!-- Decorative Shapes -->
          <div class="absolute top-10 left-10 neo-shape-circle opacity-20 hidden lg:block"></div>
          <div class="absolute bottom-10 right-10 neo-shape-square opacity-20 hidden lg:block"></div>
        </div>
      </div>
    </section>

    <!-- Divider Ultra -->
    <div class="neo-divider-ultra"></div>

    <!-- Features Section -->
    <section class="neo-section bg-white border-b-neo-extra border-neo-black">
      <div class="neo-container">
        <div class="text-center mb-16">
          <div class="inline-block neo-sticker neo-sticker-sunset mb-6">
            🚀 CARACTERÍSTICAS
          </div>
          <h2 class="neo-heading neo-h2 mb-6 text-neo-black">
            ¿Por qué elegir MenuPlus?
          </h2>
          <p class="neo-text neo-text-xl text-neo-gray max-w-2xl mx-auto">
            La solución completa para gestionar los menús digitales de tu negocio.
          </p>
        </div>

        <div class="neo-grid-3">
          <!-- Feature 1 - Card 3D -->
          <div class="neo-card-3d rotate-[1deg] neo-hover-lift">
            <div class="neo-icon-3d neo-icon-3d-flame mb-6 mx-auto">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
            </div>
            <h3 class="neo-heading neo-h4 mb-3 text-center">Fácil de Usar</h3>
            <p class="neo-text text-neo-gray text-center">Interfaz intuitiva para crear y gestionar tus menús en minutos.</p>
          </div>

          <!-- Feature 2 - Card 3D Sunset -->
          <div class="neo-card-3d-sunset rotate-[-1deg] neo-hover-lift">
            <div class="neo-icon-3d neo-icon-3d-lavender mb-6 mx-auto">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="neo-heading neo-h4 mb-3 text-center">Códigos QR</h3>
            <p class="neo-text text-center">Genera códigos QR para que tus clientes accedan al menú al instante.</p>
          </div>

          <!-- Feature 3 - Card 3D Flame -->
          <div class="neo-card-3d-flame rotate-[2deg] neo-hover-lift">
            <div class="neo-icon-3d neo-icon-3d-sunset mb-6 mx-auto">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="neo-heading neo-h4 mb-3 text-center text-white">Imágenes</h3>
            <p class="neo-text text-center text-white/90">Agrega imágenes a tus platillos para hacerlos más atractivos a los clientes.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Demo Section -->
    <section class="neo-section neo-bg-gradient-sunset-lavender border-b-neo-extra border-neo-black relative overflow-hidden">
      <!-- Decorative Pattern -->
      <div class="absolute inset-0 neo-bg-dots-colorful opacity-30 pointer-events-none"></div>

      <div class="max-w-4xl mx-auto text-center neo-container relative z-10">
        <div class="neo-card-3d p-12 neo-corner-accent">
          <div class="neo-sticker neo-sticker-flame mb-6 neo-badge-float">
            🎯 DEMO GRATIS
          </div>
          <h2 class="neo-heading neo-h2 mb-6">
            Prueba nuestro menú de demostración
          </h2>
          <p class="neo-text neo-text-lg mb-10 text-neo-gray max-w-2xl mx-auto">
            Experimenta cómo se ve un menú digital profesional creado con MenuPlus.
          </p>
          <a
            href="/menu/11111111-1111-1111-1111-111111111111"
            class="neo-btn-super neo-bounce inline-flex items-center justify-center"
          >
            Ver menú de ejemplo
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="neo-section bg-neo-black border-b-neo-extra border-neo-flame relative overflow-hidden">
      <!-- Animated Background Pattern -->
      <div class="absolute inset-0 neo-bg-grid-colorful opacity-10 pointer-events-none"></div>

      <div class="max-w-4xl mx-auto text-center neo-container relative z-10">
        <div class="neo-sticker mb-8 neo-badge-float" style="background-color: var(--neo-flame); color: white;">
          🚀 COMIENZA AHORA
        </div>
        <h2 class="neo-heading neo-h1 text-white mb-6">
          ¿Listo para comenzar?
        </h2>
        <p class="neo-text neo-text-xl mb-12 text-white/80 max-w-2xl mx-auto">
          Únete a miles de negocios que ya utilizan MenuPlus para gestionar sus menús digitales.
        </p>
        <a
          href="/register"
          class="neo-btn-super neo-btn-super-sunset neo-btn-pulse inline-flex items-center justify-center"
        >
          {t('auth.registerButton', lang)}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Custom rotation utilities */
  .rotate-\[1deg\] { transform: rotate(1deg); }
  .rotate-\[-1deg\] { transform: rotate(-1deg); }
  .rotate-\[2deg\] { transform: rotate(2deg); }
  .rotate-\[-2deg\] { transform: rotate(-2deg); }
</style>
