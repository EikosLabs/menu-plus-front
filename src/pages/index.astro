---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n/utils";

// Verificar si el usuario está autenticado
const token = Astro.cookies.get("auth_token")?.value;

// Si el usuario está autenticado, redirigir al dashboard
if (token) {
	return Astro.redirect("/dashboard");
}

const lang = "es";
---

<BaseLayout
  title={t('navigation.home', lang)}
  description={t('dashboard.welcome', lang)}
  lang={lang}
>
  <div class="min-h-screen bg-neo-lavender relative overflow-hidden">
    <!-- Animated Background Pattern - Same as Dashboard -->
    <div class="absolute inset-0 neo-bg-dots opacity-10 pointer-events-none"></div>

    <!-- Hero Section -->
    <section class="relative z-10">
      <div class="neo-container py-20 md:py-32">
        <div class="text-center relative">
          <!-- Floating Badge -->
          <div class="inline-block neo-sticker neo-sticker-flame mb-8 animate-fadeIn">
            ✨ Menús Digitales Profesionales
          </div>

          <!-- Main Title -->
          <h1 class="neo-heading neo-h1 mb-6 animate-slideDown">
            {t('dashboard.welcome', lang)}
            <span class="block text-neo-flame mt-2">MenuPlus</span>
          </h1>

          <!-- Subtitle -->
          <p class="neo-text neo-text-xl mb-12 text-neo-gray max-w-3xl mx-auto animate-fadeIn" style="animation-delay: 0.2s;">
            Crea y gestiona menús digitales para tu negocio. Comparte códigos QR y atrae más clientes con nuestra plataforma profesional.
          </p>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center animate-fadeIn" style="animation-delay: 0.4s;">
            <a href="/register" class="neo-btn neo-btn-primary w-full sm:w-auto">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
              {t('auth.register', lang)}
            </a>
            <a href="/login" class="neo-btn neo-btn-secondary w-full sm:w-auto">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {t('auth.login', lang)}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="relative z-10 py-16 md:py-24">
      <div class="neo-container">
        <div class="text-center mb-12">
          <div class="inline-block neo-sticker neo-sticker-sunset mb-6">
            🚀 Características
          </div>
          <h2 class="neo-heading neo-h2 mb-4">
            ¿Por qué elegir MenuPlus?
          </h2>
          <p class="neo-text neo-text-lg text-neo-gray max-w-2xl mx-auto">
            La solución completa para gestionar los menús digitales de tu negocio.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Feature 1 -->
          <div class="neo-card-3d animate-fadeIn" style="animation-delay: 0.1s;">
            <div class="flex items-center mb-4">
              <div class="neo-icon-wrapper neo-icon-flame mr-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="neo-heading neo-h4">Fácil de Usar</h3>
            </div>
            <p class="neo-text text-neo-gray">Interfaz intuitiva para crear y gestionar tus menús en minutos, sin conocimientos técnicos.</p>
          </div>

          <!-- Feature 2 -->
          <div class="neo-card-3d animate-fadeIn" style="animation-delay: 0.2s;">
            <div class="flex items-center mb-4">
              <div class="neo-icon-wrapper neo-icon-sunset mr-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
                </svg>
              </div>
              <h3 class="neo-heading neo-h4">Códigos QR</h3>
            </div>
            <p class="neo-text text-neo-gray">Genera códigos QR personalizados para que tus clientes accedan al menú al instante desde sus móviles.</p>
          </div>

          <!-- Feature 3 -->
          <div class="neo-card-3d animate-fadeIn" style="animation-delay: 0.3s;">
            <div class="flex items-center mb-4">
              <div class="neo-icon-wrapper neo-icon-lavender mr-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <h3 class="neo-heading neo-h4">Imágenes HD</h3>
            </div>
            <p class="neo-text text-neo-gray">Agrega imágenes de alta calidad a tus platillos para hacerlos más atractivos y aumentar ventas.</p>
          </div>

          <!-- Feature 4 -->
          <div class="neo-card-3d animate-fadeIn" style="animation-delay: 0.4s;">
            <div class="flex items-center mb-4">
              <div class="neo-icon-wrapper neo-icon-flame mr-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                </svg>
              </div>
              <h3 class="neo-heading neo-h4">Templates Personalizables</h3>
            </div>
            <p class="neo-text text-neo-gray">Elige entre múltiples diseños profesionales que se adaptan a la identidad de tu marca.</p>
          </div>

          <!-- Feature 5 -->
          <div class="neo-card-3d animate-fadeIn" style="animation-delay: 0.5s;">
            <div class="flex items-center mb-4">
              <div class="neo-icon-wrapper neo-icon-sunset mr-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="neo-heading neo-h4">Actualización Instantánea</h3>
            </div>
            <p class="neo-text text-neo-gray">Actualiza precios y disponibilidad en tiempo real, sin necesidad de reimprimir menús físicos.</p>
          </div>

          <!-- Feature 6 -->
          <div class="neo-card-3d animate-fadeIn" style="animation-delay: 0.6s;">
            <div class="flex items-center mb-4">
              <div class="neo-icon-wrapper neo-icon-lavender mr-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
              </div>
              <h3 class="neo-heading neo-h4">Múltiples Monedas</h3>
            </div>
            <p class="neo-text text-neo-gray">Soporte para más de 20 monedas internacionales, perfecto para negocios globales.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Demo Section -->
    <section class="relative z-10 py-16 md:py-24">
      <div class="neo-container">
        <div class="max-w-4xl mx-auto">
          <div class="neo-card-3d p-8 md:p-12 text-center">
            <div class="neo-sticker neo-sticker-flame mb-6 inline-block">
              🎯 DEMO GRATIS
            </div>
            <h2 class="neo-heading neo-h2 mb-6">
              Prueba nuestro menú de demostración
            </h2>
            <p class="neo-text neo-text-lg mb-10 text-neo-gray max-w-2xl mx-auto">
              Experimenta cómo se ve un menú digital profesional creado con MenuPlus.
            </p>
            <a
              href="/menu/11111111-1111-1111-1111-111111111111"
              class="neo-btn neo-btn-primary inline-flex items-center justify-center"
            >
              Ver menú de ejemplo
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="relative z-10 py-16 md:py-24 bg-neo-lavender">
      <div class="neo-container">
        <div class="max-w-4xl mx-auto">
          <div class="neo-card-3d p-8 md:p-12 text-center bg-neo-flame">
            <div class="neo-sticker neo-sticker-sunset mb-6 inline-block">
              🚀 COMIENZA AHORA
            </div>
            <h2 class="neo-heading neo-h2 text-white mb-6">
              ¿Listo para comenzar?
            </h2>
            <p class="neo-text neo-text-lg mb-10 text-white/90 max-w-2xl mx-auto">
              Únete a miles de negocios que ya utilizan MenuPlus para gestionar sus menús digitales.
            </p>
            <a
              href="/register"
              class="neo-btn neo-btn-secondary inline-flex items-center justify-center"
            >
              {t('auth.registerButton', lang)}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Custom rotation utilities */
  .rotate-\[1deg\] { transform: rotate(1deg); }
  .rotate-\[-1deg\] { transform: rotate(-1deg); }
  .rotate-\[2deg\] { transform: rotate(2deg); }
  .rotate-\[-2deg\] { transform: rotate(-2deg); }
</style>
