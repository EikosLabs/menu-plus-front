---
import Layout from "../layouts/Layout.astro";
import ForgotPasswordForm from "../components/ForgotPasswordForm.jsx";
---

<Layout title="Forgot Password">
  <main class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="max-w-md w-full">
      <div class="neo-card neo-card-flat p-8">
        <ForgotPasswordForm client:load />
      </div>
    </div>
  </main>
</Layout>
