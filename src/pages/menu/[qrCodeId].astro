---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import MenuHero from '../../components/menu/MenuHero.astro';
import CategoryNav from '../../components/menu/CategoryNav.astro';
import MenuSection from '../../components/menu/MenuSection.astro';
import ItemModal from '../../components/menu/ItemModal.astro';
import SurpriseButton from '../../components/menu/SurpriseButton.astro';
import { sanitizeMenuData } from '../../utils/security.js';

const { qrCodeId } = Astro.params;

let menu = null;
let error = null;
let business = null;

// Fetch menu data
try {
  const response = await fetch(`http://localhost:5000/api/menus/qr-code/${qrCodeId}`);

  if (!response.ok) {
    throw new Error(`Unable to load menu (${response.status})`);
  }

  const data = await response.json();
  menu = sanitizeMenuData(data);
  business = menu.business;
} catch (e) {
  error = e.message;
  console.error('Error loading menu:', e);
}

// Organize items by section
const itemsBySection = {};

if (menu) {
  menu.sections.forEach((section) => {
    const key = String(section.id).toLowerCase();
    itemsBySection[key] = section.menuItems || [];
  });

  if (menu.menuItems?.length) {
    itemsBySection['no-section'] = menu.menuItems;
  }
}
---

<Layout title={business?.name || 'Menu'}>
  <link rel="stylesheet" href="/src/styles/menu-variables.css" />

  <main class="menu-page">
    {error && (
      <div class="error-state">
        <div class="error-state__icon">!</div>
        <h2 class="error-state__title">Unable to Load Menu</h2>
        <p class="error-state__message">{error}</p>
        <button class="error-state__button" onclick="window.location.reload()">
          Try Again
        </button>
      </div>
    )}

    {!menu && !error && (
      <div class="loading-state">
        <div class="loading-state__spinner">
          <div class="spinner__plate"></div>
          <div class="spinner__fork"></div>
          <div class="spinner__knife"></div>
        </div>
        <p class="loading-state__text">Preparing your menu...</p>
      </div>
    )}

    {menu && !error && (
      <>
        <MenuHero business={business} />

        <CategoryNav
          sections={menu.sections}
          hasOtherItems={!!itemsBySection['no-section']}
        />

        <div class="menu-content">
          {menu.sections.map((section) => (
            <MenuSection
              section={section}
              items={itemsBySection[String(section.id).toLowerCase()] || []}
            />
          ))}

          {itemsBySection['no-section'] && (
            <MenuSection
              section={{ id: 'no-section', name: 'Other Items', description: 'Additional delicious options' }}
              items={itemsBySection['no-section']}
            />
          )}

          {Object.keys(itemsBySection).length === 0 && (
            <div class="empty-state">
              <div class="empty-state__icon">🍽️</div>
              <h2 class="empty-state__title">Our menu is being prepared</h2>
              <p class="empty-state__message">Please check back soon for our delicious offerings.</p>
            </div>
          )}
        </div>

        <footer class="menu-footer">
          <div class="menu-footer__content">
            <p class="menu-footer__powered">
              Powered by <a href="https://menu-plus.app" target="_blank" rel="noopener noreferrer" class="menu-footer__link">Menu Plus</a>
            </p>
            <p class="menu-footer__tagline">Digital menus made beautiful</p>
          </div>
        </footer>

        <ItemModal />

        <!-- Botón Sorpréndeme -->
        <SurpriseButton sections={menu.sections} menuItems={menu.menuItems || []} />
      </>
    )}
  </main>
</Layout>

<style>
  .menu-page {
    min-height: 100vh;
  }

  .menu-content {
    padding: 4rem 0;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Loading State */
  .loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    background: var(--background-primary);
  }

  .loading-state__spinner {
    position: relative;
    width: 80px;
    height: 80px;
    margin-bottom: 2rem;
  }

  .spinner__plate {
    width: 100%;
    height: 100%;
    border: 3px solid var(--accent-gold);
    border-radius: 50%;
    position: relative;
    animation: rotate 2s linear infinite;
  }

  .spinner__plate::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60%;
    height: 60%;
    border: 2px solid var(--border-light);
    border-radius: 50%;
  }

  .spinner__fork,
  .spinner__knife {
    position: absolute;
    width: 4px;
    height: 30px;
    background: var(--accent-gold);
    border-radius: 2px;
    top: 50%;
    transform: translateY(-50%);
  }

  .spinner__fork {
    left: -20px;
    animation: slideInLeft 1s ease-out infinite alternate;
  }

  .spinner__knife {
    right: -20px;
    animation: slideInRight 1s ease-out infinite alternate;
  }

  @keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes slideInLeft {
    from { transform: translateY(-50%) translateX(-10px); }
    to { transform: translateY(-50%) translateX(0); }
  }

  @keyframes slideInRight {
    from { transform: translateY(-50%) translateX(10px); }
    to { transform: translateY(-50%) translateX(0); }
  }

  .loading-state__text {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--text-secondary);
    letter-spacing: 0.05em;
  }

  /* Error State */
  .error-state {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--background-secondary);
    border-radius: var(--radius-xl);
    max-width: 500px;
    margin: 2rem auto;
  }

  .error-state__icon {
    width: 80px;
    height: 80px;
    background: var(--accent-gold);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: bold;
    margin: 0 auto 2rem;
  }

  .error-state__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .error-state__message {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .error-state__button {
    background: var(--primary-dark);
    color: var(--surface-white);
    border: none;
    padding: 1rem 2rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .error-state__button:hover,
  .error-state__button:focus {
    background: var(--accent-gold);
    transform: translateY(-2px);
    outline: none;
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--background-secondary);
    border-radius: var(--radius-xl);
    border: 2px dashed var(--border-light);
  }

  .empty-state__icon {
    font-size: 4rem;
    margin-bottom: 1.5rem;
    opacity: 0.5;
  }

  .empty-state__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .empty-state__message {
    color: var(--text-secondary);
    font-size: 1rem;
  }

  /* Footer */
  .menu-footer {
    background: var(--primary-dark);
    color: var(--surface-white);
    padding: 4rem 0;
    margin-top: 4rem;
    text-align: center;
  }

  .menu-footer__content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .menu-footer__powered {
    font-size: 0.9rem;
    opacity: 0.7;
    margin-bottom: 1.5rem;
  }

  .menu-footer__link {
    color: var(--accent-gold);
    text-decoration: none;
    font-weight: 500;
    transition: opacity var(--transition-fast);
  }

  .menu-footer__link:hover,
  .menu-footer__link:focus {
    opacity: 1;
    outline: none;
  }

  .menu-footer__tagline {
    opacity: 0.6;
    font-size: 0.8rem;
  }

  @media (max-width: 768px) {
    .menu-content {
      padding: 3rem 0;
    }
  }
</style>
