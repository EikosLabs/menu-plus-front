---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import '../../styles/menu-variables.css';
import '../../styles/templates/modern.css';
import '../../styles/templates/elegant.css';
import '../../styles/templates/casual.css';
import '../../styles/templates/minimalist.css';
import '../../styles/templates/colorful.css';
import '../../styles/templates/dark.css';
import '../../styles/templates/classic.css';
import '../../styles/business-info.css';
import '../../styles/menu-qr-page.css';

const { qrCodeId } = Astro.params;
---

<Layout title="Menu">
  <main class="menu-page">
    <div class="bg-decoration">
      <div class="bg-decoration__circle bg-decoration__circle--1"></div>
      <div class="bg-decoration__circle bg-decoration__circle--2"></div>
      <div class="bg-decoration__circle bg-decoration__circle--3"></div>
      <div class="bg-decoration__dots"></div>
    </div>

    <div id="loading-state" class="loading-state">
      <div class="loading-card">
        <div class="loading-spinner">
          <div class="spinner-ring"></div>
          <div class="spinner-ring"></div>
          <div class="spinner-ring"></div>
          <div class="spinner-plate">
            <span class="plate-emoji">🍽️</span>
          </div>
        </div>
        <h2 class="loading-title">Preparing your menu...</h2>
        <p class="loading-subtitle">Crafting the perfect dining experience</p>
        <div class="loading-dots">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    </div>

    <div id="error-state" class="error-state" style="display: none;">
      <div class="error-card">
        <div class="error-icon-wrapper">
          <div class="error-icon">⚠️</div>
          <div class="error-icon-bg"></div>
        </div>
        <h2 class="error-title">Oops! Menu Not Found</h2>
        <p class="error-message" id="error-message"></p>
        <div class="error-details">
          <div class="error-info-card">
            <h3 class="error-info-title">Possible causes:</h3>
            <ul class="error-list">
              <li>🔧 Restaurant hasn't set up their digital menu yet</li>
              <li>📅 QR code is outdated or inactive</li>
              <li>📱 Error scanning the code</li>
            </ul>
          </div>
          <div class="error-code">
            <span class="error-code-label">QR Code ID:</span>
            <code class="error-code-value">{qrCodeId}</code>
          </div>
        </div>
        <div class="error-actions">
          <button class="btn btn--primary" onclick="window.location.reload()">
            <span>🔄</span>
            <span>Try Again</span>
          </button>
          <a href="/" class="btn btn--secondary">
            <span>🏠</span>
            <span>Go Home</span>
          </a>
        </div>
      </div>
    </div>

    <div id="menu-content" style="display: none;"></div>

    <div id="dish-modal" class="dish-modal" style="display: none;">
      <div class="dish-modal-backdrop"></div>
      <div class="dish-modal-content">
        <button class="dish-modal-close" aria-label="Cerrar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <div class="dish-modal-body">
          <div class="dish-modal-image-wrapper">
            <img id="modal-dish-image" class="dish-modal-image" alt="" />
            <div class="dish-modal-image-placeholder">
              <span class="placeholder-emoji">🍴</span>
            </div>
          </div>
          <div class="dish-modal-info">
            <div class="dish-modal-header">
              <h2 id="modal-dish-name" class="dish-modal-title"></h2>
              <div id="modal-dish-price" class="dish-modal-price-badge"></div>
            </div>
            <p id="modal-dish-description" class="dish-modal-description"></p>
            <div id="modal-dish-allergens" class="dish-modal-allergens"></div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    import { loadMenu } from '../../utils/menuLoader.js';

    const pathParts = window.location.pathname.split('/');
    const qrCodeId = pathParts[pathParts.length - 1];

    loadMenu(qrCodeId);
  </script>
</Layout>
