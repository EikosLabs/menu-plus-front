---
import Layout from "../../layouts/Layout.astro";

export const prerender = false;

// Obtenemos el parámetro de la URL
const { qrCodeId } = Astro.params;

// Variables para almacenar datos del menú y errores
let menu = null;
let error = null;
let businessName = "Restaurante";
let loading = true;

try {
	// Llamada a la API para obtener el menú por QR sin autenticación
	const response = await fetch(
		`http://localhost:5000/api/menus/qr-code/${qrCodeId}`,
	);

	if (!response.ok) {
		// Si la respuesta no es OK, manejamos el error
		throw new Error(
			`Error al cargar el menú: ${response.status} ${response.statusText}`,
		);
	}

	// Convertimos la respuesta a JSON
	menu = await response.json();
	loading = false;
} catch (err) {
	console.error("Error cargando el menú:", err);
	error =
		err.message || "Error al cargar el menú. Por favor, intente más tarde.";
	loading = false;
}

// Organizamos los elementos del menú por sección
const menuItemsBySection =
	menu?.menuItems?.reduce((acc, item) => {
		const sectionId = item.sectionId || "no-section";
		(acc[sectionId] ||= []).push(item);
		return acc;
	}, {}) ?? {};

// Obtenemos las secciones del menú
const sections = menu?.sections || [];

// Creamos un mapa de secciones para facilitar el acceso
const sectionMap = sections.reduce((acc, section) => {
	acc[section.id] = section;
	return acc;
}, {});

// Si hay elementos sin sección, los organizamos en una sección especial
const hasItemsWithoutSection = menuItemsBySection["no-section"]?.length > 0;

// Nombre de categorías (placeholder - idealmente se obtendrían del backend)
const categoryNames = {
	0: "Sin categoría",
	1: "Entradas",
	2: "Platos Principales",
	3: "Postres",
	4: "Bebidas",
};
---

<Layout title={menu ? `${menu.name} - Menú Digital` : "Menú Digital"}>
  <div class="menu-container">
    <!-- Hero Section -->
    <div class="hero-section">
      <div class="overlay">
        <div class="header-content">
          <div class="logo-container" data-aos="zoom-in">
            <img src="/favicon.svg" alt="Menu Plus Logo" class="logo-image" />
          </div>
          <h1 class="hero-title" data-aos="fade-up" data-aos-delay="200">
            {menu ? menu.name : "Menú Digital"}
          </h1>
          {menu?.description && (
            <p class="hero-description" data-aos="fade-up" data-aos-delay="400">
              {menu.description}
            </p>
          )}
          <div class="scroll-indicator" data-aos="fade-up" data-aos-delay="600">
            <span>Ver menú</span>
            <div class="mouse">
              <div class="wheel"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Loader -->
    {loading && (
      <div class="loader-container">
        <div class="fancy-loader">
          <div class="plate"></div>
          <div class="fork"></div>
          <div class="knife"></div>
          <div class="loader-text">Cargando menú...</div>
        </div>
      </div>
    )}

    <!-- Error Message -->
    {error && (
      <div class="error-container" data-aos="fade-in">
        <div class="error-icon">!</div>
        <h2>Oops, algo salió mal</h2>
        <p>{error}</p>
        <button class="retry-button" onclick="window.location.reload()">
          Intentar nuevamente
        </button>
      </div>
    )}

    <!-- Menu Content -->
    {!loading && !error && menu && (
      <main class="menu-content">
        <!-- Navbar de secciones sticky -->
        <nav class="category-navbar">
          <div class="category-scroll">
            {sections.map((section) => (
              <a href={`#section-${section.id}`} class="category-link">
                {section.name}
              </a>
            ))}
            {hasItemsWithoutSection && (
              <a href="#section-no-section" class="category-link">
                Otros platos
              </a>
            )}
          </div>
        </nav>

        <!-- Secciones con orden -->
        {sections.sort((a, b) => (a.order || 0) - (b.order || 0)).map((section) => (
          <section id={`section-${section.id}`} class="menu-section" data-aos="fade-up">
            <div class="category-header">
              <h2 class="category-title">
                {section.name}
              </h2>
              {section.description && (
                <p class="section-description">{section.description}</p>
              )}
              <div class="category-decoration">
                <span class="line"></span>
                <span class="icon"></span>
                <span class="line"></span>
              </div>
            </div>

            <div class="items-grid">
              {(menuItemsBySection[section.id] || []).map((item) => (
                <div class={`menu-item ${!item.isAvailable ? 'unavailable' : ''}`} data-aos="fade-up">
                  <div class="item-content">
                    <div class="item-image-container">
                      <img 
                        src={item.imageUri || 'https://ooni.com/cdn/shop/articles/20220211142347-margherita-9920_ba86be55-674e-4f35-8094-2067ab41a671.jpg?v=1737104576&width=1080'} 
                        alt={item.name}
                        loading="lazy"
                        class="item-image"
                        style={`view-transition-name: item-image-${item.id}`}
                      />
                      {!item.isAvailable && (
                        <div class="unavailable-tag">No disponible</div>
                      )}
                    </div>
                    <div class="item-details">
                      <div class="item-header">
                        <h3 class="item-name" style={`view-transition-name: item-name-${item.id}`}>{item.name}</h3>
                        <div class="item-price" style={`view-transition-name: item-price-${item.id}`}>${item.price.toFixed(2)}</div>
                      </div>
                      {item.description && (
                        <p class="item-description">{item.description}</p>
                      )}
                      <button 
                        class="view-details-btn" 
                        data-id={item.id}
                        data-name={item.name}
                        data-price={item.price}
                        data-description={item.description || ''}
                        data-image={item.imageUri || 'https://ooni.com/cdn/shop/articles/20220211142347-margherita-9920_ba86be55-674e-4f35-8094-2067ab41a671.jpg?v=1737104576&width=1080'}
                        data-available={item.isAvailable ? 'true' : 'false'}
                        onclick="openModalFromButton(this)"
                      >
                        Ver detalles
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}

        <!-- Sección para elementos sin sección -->
        {hasItemsWithoutSection && (
          <section id="section-no-section" class="menu-section" data-aos="fade-up">
            <div class="category-header">
              <h2 class="category-title">
                Otros platos
              </h2>
              <div class="category-decoration">
                <span class="line"></span>
                <span class="icon"></span>
                <span class="line"></span>
              </div>
            </div>

            <div class="items-grid">
              {menuItemsBySection['no-section'].map((item) => (
                <div class={`menu-item ${!item.isAvailable ? 'unavailable' : ''}`} data-aos="fade-up">
                  <div class="item-content">
                    <div class="item-image-container">
                      <img 
                        src={item.imageUri || 'https://ooni.com/cdn/shop/articles/20220211142347-margherita-9920_ba86be55-674e-4f35-8094-2067ab41a671.jpg?v=1737104576&width=1080'} 
                        alt={item.name}
                        loading="lazy"
                        class="item-image"
                        style={`view-transition-name: item-image-${item.id}`}
                      />
                      {!item.isAvailable && (
                        <div class="unavailable-tag">No disponible</div>
                      )}
                    </div>
                    <div class="item-details">
                      <div class="item-header">
                        <h3 class="item-name" style={`view-transition-name: item-name-${item.id}`}>{item.name}</h3>
                        <div class="item-price" style={`view-transition-name: item-price-${item.id}`}>${item.price.toFixed(2)}</div>
                      </div>
                      {item.description && (
                        <p class="item-description">{item.description}</p>
                      )}
                      <button 
                        class="view-details-btn" 
                        data-id={item.id}
                        data-name={item.name}
                        data-price={item.price}
                        data-description={item.description || ''}
                        data-image={item.imageUri || 'https://ooni.com/cdn/shop/articles/20220211142347-margherita-9920_ba86be55-674e-4f35-8094-2067ab41a671.jpg?v=1737104576&width=1080'}
                        data-available={item.isAvailable ? 'true' : 'false'}
                        onclick="openModalFromButton(this)"
                      >
                        Ver detalles
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Si no hay elementos en el menú -->
        {menu.menuItems && menu.menuItems.length === 0 && (
          <div class="empty-menu" data-aos="fade-in">
            <div class="empty-icon">🍽️</div>
            <h2>Menú en preparación</h2>
            <p>Pronto agregaremos deliciosos platos a este menú.</p>
          </div>
        )}
      </main>
    )}

    <!-- Modal para detalles de plato -->
    <div id="item-modal" class="item-modal">
      <div class="modal-content">
        <span class="close-modal">&times;</span>
        <div class="modal-body">
          <div class="modal-image-container">
            <img id="modal-image" src="" alt="" style="view-transition-name: modal-image" />
          </div>
          <div class="modal-details">
            <h2 id="modal-name" style="view-transition-name: modal-name"></h2>
            <div class="modal-price-container">
              <div id="modal-price" style="view-transition-name: modal-price"></div>
              <div id="modal-availability" class="modal-badge"></div>
            </div>
            <div class="modal-description-container">
              <h3>Descripción</h3>
              <p id="modal-description"></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="menu-footer">
      <div class="footer-content">
        <div class="powered-by">
          <span>Powered by</span>
          <div class="powered-logo">Menu Plus</div>
        </div>
        <div class="social-links">
          <a href="#" class="social-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
          <a href="#" class="social-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
        </div>
      </div>
    </footer>
  </div>

  <!-- AOS Script para animaciones -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      // Cargar AOS de manera segura
      const loadAOS = function() {
        try {
          if (typeof AOS !== 'undefined') {
            AOS.init({
              duration: 800,
              easing: 'ease-out',
              once: false,
              mirror: false
            });

            // Animación de navegación sticky
            const categoryNav = document.querySelector('.category-navbar');
            if (categoryNav) {
              window.addEventListener('scroll', function() {
                if (window.scrollY > 300) {
                  categoryNav.classList.add('sticky-nav');
                } else {
                  categoryNav.classList.remove('sticky-nav');
                }
              });
            }
          } else {
            console.warn('AOS no está disponible. Las animaciones no funcionarán.');
            
            // Habilitar la navegación sticky incluso sin AOS
            const categoryNav = document.querySelector('.category-navbar');
            if (categoryNav) {
              categoryNav.style.transform = 'translateY(0)';
              categoryNav.style.opacity = '1';
              
              window.addEventListener('scroll', function() {
                if (window.scrollY > 300) {
                  categoryNav.classList.add('sticky-nav');
                } else {
                  categoryNav.classList.remove('sticky-nav');
                }
              });
            }
          }
        } catch (error) {
          console.error('Error inicializando AOS:', error);
        }
      };

      // Cargar el script AOS dinámicamente
      const loadScript = function(src, callback) {
        const script = document.createElement('script');
        script.type = 'text/javascript';
        script.src = src;
        script.onload = callback;
        script.onerror = function() {
          console.error('Error cargando el script:', src);
          callback(); // Llamar callback incluso en error para mantener la funcionalidad básica
        };
        document.body.appendChild(script);
      };

      // Cargar CSS de AOS
      const loadCSS = function(href) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = href;
        document.head.appendChild(link);
      };

      // Cargar recursos de AOS
      loadCSS('https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css');
      loadScript('https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js', loadAOS);
      
      // Scroll suave para links de navegación (no depende de AOS)
      document.querySelectorAll('.category-link').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
          e.preventDefault();
          const targetId = this.getAttribute('href');
          const targetElement = document.querySelector(targetId);
          
          if (targetElement) {
            const headerOffset = 80;
            const elementPosition = targetElement.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
            
            window.scrollTo({
              top: offsetPosition,
              behavior: 'smooth'
            });
          }
        });
      });
      
      // Efecto parallax en el hero (funciona sin AOS)
      window.addEventListener('scroll', function() {
        const heroSection = document.querySelector('.hero-section');
        if (heroSection) {
          const scrollPosition = window.pageYOffset;
          heroSection.style.backgroundPositionY = scrollPosition * 0.5 + 'px';
        }
      });
      
      // Añadir clases de animación fallback para los elementos cuando AOS no está disponible
      if (typeof AOS === 'undefined') {
        document.querySelectorAll('[data-aos]').forEach(element => {
          element.style.opacity = '1';
          element.style.transform = 'none';
        });
      }

      // Modal para detalles de plato
      const modal = document.getElementById('item-modal');
      const closeBtn = document.querySelector('.close-modal');
      
      // Cerrar modal con botón X
      if (closeBtn) {
        closeBtn.addEventListener('click', function() {
          closeModal();
        });
      }
      
      // Cerrar modal al hacer clic fuera del contenido
      window.addEventListener('click', function(event) {
        if (event.target === modal) {
          closeModal();
        }
      });
      
      // Cerrar modal con Escape
      document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape' && modal.classList.contains('show-modal')) {
          closeModal();
        }
      });
      
      // Función para manejar View Transitions
      const startViewTransition = (callback) => {
        if (!document.startViewTransition) {
          callback();
          return;
        }
        
        document.startViewTransition(() => {
          callback();
        });
      };
      
      // Función global para abrir el modal desde botón con data attributes
      window.openModalFromButton = function(button) {
        const item = {
          id: button.dataset.id,
          name: button.dataset.name,
          price: parseFloat(button.dataset.price),
          description: button.dataset.description,
          imageUri: button.dataset.image,
          isAvailable: button.dataset.available === 'true'
        };
        
        openModalWithItem(item);
      };
      
      // Función para abrir el modal con un objeto item
      function openModalWithItem(item) {
        const modalImage = document.getElementById('modal-image');
        const modalName = document.getElementById('modal-name');
        const modalPrice = document.getElementById('modal-price');
        const modalDesc = document.getElementById('modal-description');
        const modalAvailability = document.getElementById('modal-availability');
        
        // Definir transiciones con View Transition API para elementos específicos
        startViewTransition(() => {
          // Rellenar datos del modal
          modalImage.src = item.imageUri || 'https://ooni.com/cdn/shop/articles/20220211142347-margherita-9920_ba86be55-674e-4f35-8094-2067ab41a671.jpg?v=1737104576&width=1080';
          modalImage.alt = item.name;
          modalImage.style.display = 'block';
          
          modalName.textContent = item.name;
          modalPrice.textContent = `$${parseFloat(item.price).toFixed(2)}`;
          modalDesc.textContent = item.description || 'Sin descripción';
          
          if (item.isAvailable) {
            modalAvailability.textContent = 'Disponible';
            modalAvailability.className = 'modal-badge available';
          } else {
            modalAvailability.textContent = 'No disponible';
            modalAvailability.className = 'modal-badge unavailable';
          }
          
          // Mostrar modal con animación
          modal.classList.add('show-modal');
          document.body.style.overflow = 'hidden'; // Evitar scroll
        });
      }
      
      // Función global para cerrar el modal
      window.closeModal = function() {
        startViewTransition(() => {
          modal.classList.remove('show-modal');
          document.body.style.overflow = ''; // Restaurar scroll
        });
      };
    });
  </script>
</Layout>

<style>
  /* Variables CSS */
  :root {
    --primary-color: #003A57;
    --secondary-color: #1a1a1a;
    --accent-color: #333333;
    --text-primary: #333333;
    --text-secondary: #666666;
    --background-primary: #F9F9F9;
    --background-secondary: #FFFFFF;
    --card-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    --transition-speed: 0.4s;
  }
  
  /* Reset y estilos globales */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  
  body {
    background-color: var(--background-primary);
    color: var(--text-primary);
    font-family: 'Poppins', 'Segoe UI', sans-serif;
    overflow-x: hidden;
  }
  
  .menu-container {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  
  /* Hero Section */
  .hero-section {
    height: 100vh;
    background-image: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3)), 
                      url('https://images.unsplash.com/photo-1555396273-367ea4eb4db5?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1374&q=80');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    position: relative;
  }
  
  .overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.4) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .header-content {
    text-align: center;
    color: white;
    max-width: 800px;
    padding: 0 20px;
  }
  
  .logo-container {
    margin-bottom: 2rem;
  }
  
  .logo-image {
    width: 80px;
    height: 80px;
    object-fit: contain;
  }
  
  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    letter-spacing: -0.5px;
    text-shadow: 0px 2px 10px rgba(0, 0, 0, 0.3);
  }
  
  .hero-description {
    font-size: 1.2rem;
    margin-bottom: 3rem;
    opacity: 0.9;
    line-height: 1.6;
  }
  
  .scroll-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 2rem;
    opacity: 0.8;
  }
  
  .mouse {
    width: 26px;
    height: 46px;
    border: 2px solid white;
    border-radius: 20px;
    margin-top: 10px;
    position: relative;
  }
  
  .wheel {
    width: 4px;
    height: 8px;
    background: white;
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    border-radius: 2px;
    animation: wheel 1.5s infinite;
  }
  
  @keyframes wheel {
    0% {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }
    100% {
      transform: translateX(-50%) translateY(20px);
      opacity: 0;
    }
  }
  
  /* Loader */
  .loader-container {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    background-color: var(--background-primary);
  }
  
  .fancy-loader {
    position: relative;
    width: 200px;
    height: 200px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  
  .plate {
    width: 100px;
    height: 100px;
    background: rgba(225, 225, 225, 0.3);
    border-radius: 50%;
    position: relative;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.05);
    animation: pulse 1.5s infinite ease-in-out;
  }
  
  .fork, .knife {
    position: absolute;
    width: 60px;
    height: 8px;
    background: var(--secondary-color);
    border-radius: 4px;
  }
  
  .fork {
    top: 50%;
    left: 25%;
    transform: rotate(45deg);
    animation: fork 1.5s infinite ease-in-out;
  }
  
  .knife {
    top: 50%;
    right: 25%;
    transform: rotate(-45deg);
    animation: knife 1.5s infinite ease-in-out;
  }
  
  .loader-text {
    margin-top: 40px;
    color: var(--primary-color);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 1px;
  }
  
  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.05); opacity: 0.8; }
  }
  
  @keyframes fork {
    0%, 100% { transform: rotate(45deg) translateY(0); }
    50% { transform: rotate(35deg) translateY(-5px); }
  }
  
  @keyframes knife {
    0%, 100% { transform: rotate(-45deg) translateY(0); }
    50% { transform: rotate(-35deg) translateY(-5px); }
  }
  
  /* Error Container */
  .error-container {
    padding: 5rem 1rem;
    text-align: center;
    max-width: 500px;
    margin: 0 auto;
  }
  
  .error-icon {
    font-size: 3rem;
    width: 80px;
    height: 80px;
    line-height: 80px;
    border-radius: 50%;
    background-color: rgba(224, 92, 51, 0.1);
    color: var(--secondary-color);
    margin: 0 auto 1.5rem;
    font-weight: bold;
  }
  
  .retry-button {
    margin-top: 1.5rem;
    padding: 0.75rem 1.5rem;
    background-color: var(--secondary-color);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    cursor: pointer;
    transition: background-color 0.3s;
  }
  
  .retry-button:hover {
    background-color: var(--accent-color);
  }
  
  /* Menu Content */
  .menu-content {
    padding: 2rem 1rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  
  /* Category Navbar */
  .category-navbar {
    position: sticky;
    top: 0;
    background-color: rgba(255, 255, 255, 0.95);
