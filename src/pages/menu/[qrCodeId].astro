---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import '../../styles/menu-variables.css';
import '../../styles/templates/modern.css';
import '../../styles/templates/elegant.css';
import '../../styles/templates/casual.css';
import '../../styles/templates/minimalist.css';
import '../../styles/templates/colorful.css';
import '../../styles/templates/dark.css';
import '../../styles/templates/classic.css';
import '../../styles/business-info.css';
import '../../styles/menu-qr-page.css';
import '../../styles/neobrutalist.css';

const { qrCodeId } = Astro.params;
---

<Layout title="Menu">
  <main class="menu-page min-h-screen relative">

    {/* LOADING STATE */}
    <div id="loading-state" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-white/80 backdrop-blur-md transition-all duration-500">
      <div class="relative flex flex-col items-center">
        <div class="w-20 h-20 mb-6 relative">
          <div class="absolute inset-0 rounded-full border-4 border-gray-100"></div>
          <div class="absolute inset-0 rounded-full border-4 border-t-blue-500 animate-spin"></div>
          <div class="absolute inset-0 flex items-center justify-center text-3xl animate-bounce">
            🍽️
          </div>
        </div>
        <h2 class="text-2xl font-bold mb-2 text-gray-800 tracking-tight">Preparando tu experiencia</h2>
        <p class="text-gray-500 font-medium animate-pulse">Cargando menú delicioso...</p>
      </div>
    </div>

    {/* ERROR STATE */}
    <div id="error-state" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-white/90 hidden backdrop-blur-md opacity-0 transition-opacity duration-300" style="opacity: 0;">
      <div class="bg-white p-8 md:p-10 max-w-md w-full rounded-[2rem] shadow-[0_20px_60px_-15px_rgba(0,0,0,0.1)] text-center relative overflow-hidden border border-gray-100">
        <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-red-400 to-pink-500"></div>
        
        <div class="mb-6 mx-auto w-24 h-24 bg-red-50 rounded-full flex items-center justify-center text-5xl shadow-inner">
          ⚠️
        </div>
        
        <h2 class="text-2xl font-black mb-3 text-gray-800">Menú no disponible</h2>
        <p id="error-message" class="text-gray-500 mb-8 leading-relaxed">
          No pudimos cargar el menú solicitado. Por favor verifica el código QR o intenta nuevamente.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <button onclick="window.location.reload()" class="bg-gray-900 hover:bg-black text-white px-6 py-3 rounded-xl font-bold transition-transform hover:-translate-y-1 shadow-lg hover:shadow-xl active:scale-95">
            🔄 Reintentar
          </button>
          <a href="/" class="bg-gray-100 hover:bg-gray-200 text-gray-800 px-6 py-3 rounded-xl font-bold transition-transform hover:-translate-y-1 active:scale-95">
            🏠 Inicio
          </a>
        </div>
      </div>
    </div>

    <div id="menu-content" style="display: none;" class="relative z-10"></div>

    <div id="dish-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4">
      <div class="dish-modal-backdrop absolute inset-0 bg-black/80 backdrop-blur-sm"></div>
      <div class="dish-modal-content relative animate-up">
        <button class="dish-modal-close">
          <svg class="w-6 h-6 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        
        <div class="dish-modal-image-wrapper">
          <img id="modal-dish-image" class="w-full h-full object-cover" alt="" />
          <div class="dish-modal-image-placeholder absolute inset-0 flex items-center justify-center text-6xl text-gray-300">
            <span>🥘</span>
          </div>
        </div>
        
        <div class="dish-modal-body">
          <h2 id="modal-dish-name"></h2>
          <div id="modal-dish-price"></div>
          <p id="modal-dish-description"></p>
          <div id="modal-dish-allergens"></div>
        </div>
      </div>
    </div>
  </main>

  <script>
    import { loadMenu } from '../../utils/menuLoader.js';

    const pathParts = window.location.pathname.split('/');
    const qrCodeId = pathParts[pathParts.length - 1];

    loadMenu(qrCodeId);
  </script>
</Layout>
