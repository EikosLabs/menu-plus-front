---
import Layout from '../layouts/Layout.astro';
import RegisterForm from '../components/RegisterForm.jsx';
---
<Layout title="Crear Cuenta - Menu Plus Platform">
  <main class="min-h-screen flex flex-col items-center justify-center p-6 animate-fade-in">
    <div class="bg-white text-[#0A3342] p-8 md:p-12 rounded-xl shadow-2xl w-full max-w-md">
      <img src="/favicon.svg" alt="Menu Plus Platform Logo" class="w-32 mx-auto mb-8" />
      <h1 class="text-4xl font-bold text-center text-[#004E71] mb-2">Crea tu Cuenta Gratis</h1>
      <p class="text-center text-slate-600 mb-10">Únete y empieza a mostrar tu menú al mundo.</p>
      
      <RegisterForm client:load />

      <div class="mt-8 text-center">
        <p class="text-sm text-slate-600">
          ¿Ya tienes una cuenta? 
          <a href="/login" class="font-medium text-[#E05C33] hover:underline">Inicia Sesión</a>
        </p>
      </div>
    </div>
  </main>
</Layout> 