---
import Layout from '../layouts/Layout.astro';
import OnboardingFlow from '../components/onboarding/OnboardingFlow';
import '../styles/onboarding.css';

// Verificar autenticación - buscar en ambas cookies posibles
const token = Astro.cookies.get('auth_token')?.value || Astro.cookies.get('token')?.value;
if (!token) {
  return Astro.redirect('/login');
}
---

<Layout title="Configuración de Negocio">
  <OnboardingFlow client:only="react" userId={null} onComplete={null} />
</Layout>
