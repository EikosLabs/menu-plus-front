---
import Layout from '../layouts/Layout.astro';
import BusinessMap from '../components/BusinessMap.jsx';
import BusinessSchedule from '../components/BusinessSchedule.jsx';

// Obtener todas las rutas estáticas válidas para build
export async function getStaticPaths() {
  // En modo SSR (output: 'server'), esta función no se usa para rutas dinámicas
  return [];
}

const { slug } = Astro.params;

// Validar que el slug no colisione con rutas reservadas
const reservedRoutes = ['dashboard', 'login', 'register', 'admin', 'admin-super', 'api', '404', 'menu'];
if (reservedRoutes.includes(slug)) {
  return Astro.redirect('/404');
}

// Fetch business data server-side
let business = null;
let error = null;

try {
  const API_URL = import.meta.env.PUBLIC_API_URL || '/api';
  const response = await fetch(`${API_URL}/business-landing/${slug}`);

  if (!response.ok) {
    error = `Business not found (Status: ${response.status})`;
  } else {
    business = await response.json();
  }
} catch (e) {
  error = `Failed to load business information. Error: ${e.message}. URL: ${import.meta.env.PUBLIC_API_URL || '/api'}/business-landing/${slug}`;
  console.error('Error fetching business:', e);
}
---

<Layout title={business ? `${business.name} - MenusQR` : 'Business Not Found'}>
  {error || !business ? (
    <div class="min-h-screen flex items-center justify-center bg-gray-50">
      <div class="text-center p-8 max-w-md">
        <div class="w-20 h-20 mx-auto mb-6 bg-red-100 rounded-full flex items-center justify-center text-red-500">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
        <h1 class="text-3xl font-bold text-gray-900 mb-3">Negocio no encontrado</h1>
        <p class="text-gray-500 mb-8">{error || "No pudimos encontrar la información de este negocio."}</p>
        <a
          href="/"
          class="inline-flex items-center justify-center px-8 py-3 bg-gray-900 text-white font-medium rounded-full hover:bg-gray-800 transition-all hover:shadow-lg transform hover:-translate-y-1"
        >
          Volver al inicio
        </a>
      </div>
    </div>
  ) : (
    <div
      class="min-h-screen font-sans selection:bg-black selection:text-white"
      style={{
        background: business.primaryColor 
          ? `linear-gradient(135deg, ${business.primaryColor}08 0%, #ffffff 100%)` 
          : '#FAFAFA'
      }}
    >
      <!-- Hero Section -->
      <div class="relative h-[60vh] min-h-[500px] w-full overflow-hidden">
        {business.imageUrl ? (
          <>
            <div 
              class="absolute inset-0 bg-cover bg-center bg-no-repeat transform scale-105 animate-slow-zoom"
              style={`background-image: url('${business.imageUrl}');`}
            ></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/30 backdrop-blur-[2px]"></div>
          </>
        ) : (
          <div 
            class="absolute inset-0"
            style={{
              background: `linear-gradient(135deg, ${business.primaryColor || '#111'} 0%, ${business.secondaryColor || '#333'} 100%)`
            }}
          >
            <div class="absolute inset-0 opacity-20" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')"></div>
          </div>
        )}
        
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4 max-w-5xl mx-auto z-10">
          <div class="animate-fade-in-up">
             {business.category && (
              <span 
                class="inline-block px-4 py-1.5 rounded-full text-xs font-bold tracking-widest uppercase bg-white/20 backdrop-blur-md text-white mb-6 border border-white/30"
              >
                {business.category.name}
              </span>
            )}
            <h1 class="text-5xl md:text-7xl lg:text-8xl font-black text-white mb-6 tracking-tight leading-tight drop-shadow-xl">
              {business.name}
            </h1>
            {business.slogan && (
              <p class="text-xl md:text-2xl text-white/90 font-light max-w-2xl mx-auto leading-relaxed drop-shadow-md">
                {business.slogan}
              </p>
            )}
          </div>
        </div>

        {/* Scroll Indicator */}
        <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
          <svg class="w-6 h-6 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </div>
      </div>

      <!-- Main Content Container with Glassmorphism Overlap -->
      <div class="relative z-20 -mt-20 container mx-auto px-4 pb-20 max-w-6xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
          
          <!-- Left Column: Info & Map -->
          <div class="lg:col-span-8 space-y-8 animate-fade-in-up" style="animation-delay: 0.2s">
            
            {/* About Section */}
            {business.description && (
              <div class="bg-white/80 backdrop-blur-xl rounded-3xl p-8 md:p-10 shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-white/50">
                <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
                  <span class="text-3xl">✨</span> Sobre Nosotros
                </h2>
                <p class="text-lg text-gray-600 leading-relaxed whitespace-pre-line">
                  {business.description}
                </p>
              </div>
            )}

            {/* Map Section */}
            <div class="bg-white/80 backdrop-blur-xl rounded-3xl p-2 shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-white/50 overflow-hidden">
              <div class="rounded-2xl overflow-hidden h-[400px]">
                <BusinessMap
                  client:load
                  latitude={business.latitude}
                  longitude={business.longitude}
                  businessName={business.name}
                  address={business.address}
                />
              </div>
              <div class="p-6 flex items-center justify-between">
                <div>
                  <h3 class="text-lg font-bold text-gray-900">Nuestra Ubicación</h3>
                  <p class="text-gray-500 text-sm mt-1">{business.address}</p>
                </div>
                <a
                  href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(business.address)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-12 h-12 flex items-center justify-center bg-gray-100 rounded-full hover:bg-gray-200 transition-colors text-gray-600"
                >
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                </a>
              </div>
            </div>

          </div>

          <!-- Right Column: Sidebar (Contact, Hours, CTA) -->
          <div class="lg:col-span-4 space-y-6 animate-fade-in-up" style="animation-delay: 0.4s">
            
            {/* Primary CTA - Menu */}
            {business.menuQrCodeId && (
              <div class="bg-white rounded-3xl p-6 shadow-[0_8px_30px_rgb(0,0,0,0.06)] text-center border border-gray-100 relative overflow-hidden group">
                 <div class="absolute inset-0 bg-gradient-to-br from-gray-50 to-gray-100 opacity-50"></div>
                 <div class="relative z-10">
                  <h3 class="text-xl font-bold text-gray-900 mb-2">¿Con hambre?</h3>
                  <p class="text-gray-500 text-sm mb-6">Explora nuestro delicioso menú ahora</p>
                  <a
                    href={`/menu/${business.menuQrCodeId}`}
                    class="block w-full py-4 px-6 rounded-xl text-white font-bold text-lg shadow-lg transform transition-all duration-300 hover:scale-[1.02] hover:shadow-xl focus:ring-4 focus:ring-opacity-50"
                    style={{
                      background: `linear-gradient(135deg, ${business.primaryColor || '#111'} 0%, ${business.secondaryColor || business.primaryColor || '#333'} 100%)`,
                      boxShadow: `0 10px 20px -5px ${business.primaryColor || '#000'}40`
                    }}
                  >
                    Ver Menú Completo
                  </a>
                </div>
              </div>
            )}

            {/* Contact Card */}
            <div class="bg-white/80 backdrop-blur-xl rounded-3xl p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-white/50">
              <h3 class="text-lg font-bold text-gray-900 mb-6 uppercase tracking-wider text-xs border-b pb-4">Contacto</h3>
              <ul class="space-y-6">
                {business.phoneNumber && (
                  <li>
                    <a href={`tel:${business.phoneNumber}`} class="flex items-center group">
                      <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-500 flex items-center justify-center mr-4 group-hover:scale-110 transition-transform">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                      </div>
                      <span class="text-gray-600 font-medium group-hover:text-gray-900 transition-colors">{business.phoneNumber}</span>
                    </a>
                  </li>
                )}
                {business.email && (
                  <li>
                    <a href={`mailto:${business.email}`} class="flex items-center group">
                      <div class="w-10 h-10 rounded-full bg-purple-50 text-purple-500 flex items-center justify-center mr-4 group-hover:scale-110 transition-transform">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                      </div>
                      <span class="text-gray-600 font-medium group-hover:text-gray-900 transition-colors break-all">{business.email}</span>
                    </a>
                  </li>
                )}
                 {business.address && (
                  <li class="flex items-start">
                     <div class="w-10 h-10 rounded-full bg-gray-50 text-gray-500 flex items-center justify-center mr-4 flex-shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                      </div>
                      <span class="text-gray-600 font-medium pt-2">{business.address}</span>
                  </li>
                )}
              </ul>
              
              {/* Social Pills */}
              <div class="mt-8 pt-6 border-t border-gray-100">
                <div class="flex flex-wrap gap-2">
                   {business.whatsAppNumber && (
                    <a href={`https://wa.me/${business.whatsAppNumber.replace(/[^0-9]/g, '')}`} target="_blank" class="w-10 h-10 rounded-full bg-green-500 text-white flex items-center justify-center hover:bg-green-600 transition-all hover:-translate-y-1 shadow-md">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                    </a>
                  )}
                  {business.facebookUrl && (
                    <a href={business.facebookUrl} target="_blank" class="w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center hover:bg-blue-700 transition-all hover:-translate-y-1 shadow-md">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    </a>
                  )}
                  {business.instagramUrl && (
                    <a href={business.instagramUrl} target="_blank" class="w-10 h-10 rounded-full bg-pink-600 text-white flex items-center justify-center hover:bg-pink-700 transition-all hover:-translate-y-1 shadow-md">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                    </a>
                  )}
                   {business.twitterUrl && (
                    <a href={business.twitterUrl} target="_blank" class="w-10 h-10 rounded-full bg-black text-white flex items-center justify-center hover:bg-gray-800 transition-all hover:-translate-y-1 shadow-md">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
                    </a>
                  )}
                </div>
              </div>
            </div>

            {/* Hours */}
            {business.schedules && business.schedules.length > 0 && (
              <div class="bg-white/80 backdrop-blur-xl rounded-3xl p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-white/50">
                 <h3 class="text-lg font-bold text-gray-900 mb-6 uppercase tracking-wider text-xs border-b pb-4">Horarios</h3>
                 <div class="prose prose-sm">
                  <BusinessSchedule client:load schedules={business.schedules} />
                 </div>
              </div>
            )}

          </div>
        </div>
      </div>

    </div>
  )}
</Layout>

<style>
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slow-zoom {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.1);
    }
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
  
  .animate-slow-zoom {
    animation: slow-zoom 20s linear infinite alternate;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: #e5e7eb;
    border-radius: 20px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #d1d5db;
  }
</style>
