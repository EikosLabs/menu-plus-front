---
import Button from '../components/ui/Button.jsx';
import '../styles/neobrutalist.css';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MenuPlus - Neobrutalist Design System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;700;900&family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body class="bg-neo-lavender">

    <!-- Hero Section -->
    <section class="neo-bg-dots py-16 border-b-neo-extra border-neo-black">
        <div class="neo-container">
            <div class="text-center max-w-4xl mx-auto">
                <div class="inline-block neo-badge neo-badge-flame mb-8 rotate-[-2deg]">
                    ULTRA AESTHETIC
                </div>

                <h1 class="neo-heading neo-h1 mb-6">
                    MenuPlus
                    <span class="block text-neo-flame mt-2">Diseño Neobrutlista</span>
                </h1>

                <p class="neo-text neo-text-xl mb-12 text-neo-gray max-w-2xl mx-auto">
                    Un sistema de diseño audaz y vibrante que combina bordes gruesos, sombras duras y colores impactantes para una experiencia visual inolvidable.
                </p>

                <div class="flex flex-wrap gap-6 justify-center">
                    <Button variant="primary" size="lg" client:load>
                        Comenzar Ahora
                    </Button>
                    <Button variant="outline" size="lg" client:load>
                        Ver Demo
                    </Button>
                </div>
            </div>
        </div>
    </section>

    <!-- Color Palette Section -->
    <section class="neo-section bg-white border-b-neo-extra border-neo-black">
        <div class="neo-container">
            <h2 class="neo-heading neo-h2 text-center mb-12">Paleta de Colores</h2>

            <div class="grid grid-cols-2 md:grid-cols-5 gap-6">
                <!-- Black -->
                <div class="neo-card text-center">
                    <div class="w-full h-32 bg-neo-black neo-border mb-4 rounded-lg"></div>
                    <h3 class="neo-text-bold mb-2">Black</h3>
                    <code class="neo-text text-xs bg-neo-lavender px-2 py-1 rounded">#000000</code>
                </div>

                <!-- Flame -->
                <div class="neo-card text-center">
                    <div class="w-full h-32 bg-neo-flame neo-border mb-4 rounded-lg"></div>
                    <h3 class="neo-text-bold mb-2">Flame</h3>
                    <code class="neo-text text-xs bg-neo-lavender px-2 py-1 rounded">#cf5c36</code>
                </div>

                <!-- Lavender -->
                <div class="neo-card text-center">
                    <div class="w-full h-32 bg-neo-lavender neo-border mb-4 rounded-lg"></div>
                    <h3 class="neo-text-bold mb-2">Lavender</h3>
                    <code class="neo-text text-xs bg-white px-2 py-1 rounded">#eee5e9</code>
                </div>

                <!-- Gray -->
                <div class="neo-card text-center">
                    <div class="w-full h-32 bg-neo-gray neo-border mb-4 rounded-lg"></div>
                    <h3 class="neo-text-bold mb-2">Gray</h3>
                    <code class="neo-text text-xs bg-neo-lavender px-2 py-1 rounded">#7c7c7c</code>
                </div>

                <!-- Sunset -->
                <div class="neo-card text-center">
                    <div class="w-full h-32 bg-neo-sunset neo-border mb-4 rounded-lg"></div>
                    <h3 class="neo-text-bold mb-2">Sunset</h3>
                    <code class="neo-text text-xs bg-white px-2 py-1 rounded">#efc88b</code>
                </div>
            </div>
        </div>
    </section>

    <!-- Buttons Section -->
    <section class="neo-section bg-neo-lavender">
        <div class="neo-container">
            <h2 class="neo-heading neo-h2 text-center mb-12">Botones</h2>

            <div class="grid md:grid-cols-2 gap-12">
                <!-- Button Variants -->
                <div class="neo-card-lavender neo-border neo-shadow-lg p-8">
                    <h3 class="neo-heading neo-h3 mb-6">Variantes</h3>
                    <div class="flex flex-wrap gap-4">
                        <Button variant="primary" client:load>Primary</Button>
                        <Button variant="secondary" client:load>Secondary</Button>
                        <Button variant="success" client:load>Success</Button>
                        <Button variant="danger" client:load>Danger</Button>
                        <Button variant="outline" client:load>Outline</Button>
                        <Button variant="white" client:load>White</Button>
                    </div>
                </div>

                <!-- Button Sizes -->
                <div class="neo-card neo-shadow-lg p-8">
                    <h3 class="neo-heading neo-h3 mb-6">Tamaños</h3>
                    <div class="flex flex-wrap items-center gap-4">
                        <Button variant="primary" size="sm" client:load>Small</Button>
                        <Button variant="primary" size="md" client:load>Medium</Button>
                        <Button variant="primary" size="lg" client:load>Large</Button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Cards Section -->
    <section class="neo-section bg-white border-b-neo-extra border-neo-black">
        <div class="neo-container">
            <h2 class="neo-heading neo-h2 text-center mb-12">Tarjetas</h2>

            <div class="neo-grid-3">
                <!-- Card 1 -->
                <div class="neo-card neo-card-hover rotate-[1deg]">
                    <div class="neo-badge mb-4">DESTACADO</div>
                    <h3 class="neo-heading neo-h4 mb-3">Menú Digital</h3>
                    <p class="neo-text mb-6">
                        Crea menús digitales interactivos con códigos QR. Tus clientes pueden ver el menú completo desde sus dispositivos.
                    </p>
                    <Button variant="primary" client:load>Ver más</Button>
                </div>

                <!-- Card 2 -->
                <div class="neo-card neo-card-flame neo-card-hover rotate-[-1deg]">
                    <h3 class="neo-heading neo-h4 mb-3 text-white">Gestión Fácil</h3>
                    <p class="neo-text text-white/90 mb-6">
                        Actualiza tu menú en tiempo real desde cualquier dispositivo. Sin complicaciones, sin esperas.
                    </p>
                    <Button variant="white" client:load>Comenzar</Button>
                </div>

                <!-- Card 3 -->
                <div class="neo-card neo-card-sunset neo-card-hover rotate-[2deg]">
                    <h3 class="neo-heading neo-h4 mb-3">Analytics Pro</h3>
                    <p class="neo-text mb-6">
                        Descubre qué platillos son los favoritos de tus clientes con estadísticas detalladas.
                    </p>
                    <Button variant="outline" client:load>Explorar</Button>
                </div>
            </div>
        </div>
    </section>

    <!-- Form Elements Section -->
    <section class="neo-section bg-neo-lavender">
        <div class="neo-container max-w-3xl">
            <h2 class="neo-heading neo-h2 text-center mb-12">Elementos de Formulario</h2>

            <div class="neo-card neo-shadow-xl p-8">
                <form class="space-y-6">
                    <!-- Text Input -->
                    <div>
                        <label class="neo-text-bold block mb-2" for="name">Nombre del Restaurante</label>
                        <input
                            type="text"
                            id="name"
                            class="neo-input"
                            placeholder="Ej: La Casa de las Tapas"
                        />
                    </div>

                    <!-- Email Input -->
                    <div>
                        <label class="neo-text-bold block mb-2" for="email">Email</label>
                        <input
                            type="email"
                            id="email"
                            class="neo-input"
                            placeholder="tu@email.com"
                        />
                    </div>

                    <!-- Select -->
                    <div>
                        <label class="neo-text-bold block mb-2" for="category">Categoría</label>
                        <select id="category" class="neo-input neo-select">
                            <option>Selecciona una categoría</option>
                            <option>Restaurante</option>
                            <option>Cafetería</option>
                            <option>Bar</option>
                            <option>Food Truck</option>
                        </select>
                    </div>

                    <!-- Textarea -->
                    <div>
                        <label class="neo-text-bold block mb-2" for="description">Descripción</label>
                        <textarea
                            id="description"
                            class="neo-input neo-textarea"
                            placeholder="Cuéntanos sobre tu negocio..."
                        ></textarea>
                    </div>

                    <!-- Submit Button -->
                    <div class="flex gap-4 pt-4">
                        <Button variant="primary" size="lg" type="submit" client:load>
                            Guardar Cambios
                        </Button>
                        <Button variant="outline" size="lg" type="button" client:load>
                            Cancelar
                        </Button>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- Badges & Tags Section -->
    <section class="neo-section bg-white border-b-neo-extra border-neo-black">
        <div class="neo-container">
            <h2 class="neo-heading neo-h2 text-center mb-12">Badges y Etiquetas</h2>

            <div class="flex flex-wrap gap-4 justify-center items-center">
                <span class="neo-badge">NUEVO</span>
                <span class="neo-badge neo-badge-flame">POPULAR</span>
                <span class="neo-badge rotate-[2deg]">OFERTA</span>
                <span class="neo-badge rotate-[-2deg]">PREMIUM</span>
                <span class="neo-badge neo-badge-flame rotate-[1deg]">HOT</span>
                <span class="neo-badge rotate-[-1deg]">DESTACADO</span>
            </div>
        </div>
    </section>

    <!-- Typography Section -->
    <section class="neo-section bg-neo-lavender">
        <div class="neo-container max-w-4xl">
            <h2 class="neo-heading neo-h2 text-center mb-12">Tipografía</h2>

            <div class="neo-card neo-shadow-lg p-8 space-y-8">
                <div>
                    <h1 class="neo-heading neo-h1">Heading 1 - Display</h1>
                    <p class="neo-text text-neo-gray">Font size: 3rem (48px), Font weight: 900</p>
                </div>

                <div>
                    <h2 class="neo-heading neo-h2">Heading 2 - Title</h2>
                    <p class="neo-text text-neo-gray">Font size: 2.25rem (36px), Font weight: 900</p>
                </div>

                <div>
                    <h3 class="neo-heading neo-h3">Heading 3 - Subtitle</h3>
                    <p class="neo-text text-neo-gray">Font size: 1.875rem (30px), Font weight: 900</p>
                </div>

                <div>
                    <h4 class="neo-heading neo-h4">Heading 4 - Section</h4>
                    <p class="neo-text text-neo-gray">Font size: 1.5rem (24px), Font weight: 900</p>
                </div>

                <div class="neo-divider"></div>

                <div>
                    <p class="neo-text neo-text-xl neo-text-bold mb-3">
                        Texto grande y destacado para introducciones o citas importantes.
                    </p>
                    <p class="neo-text mb-3">
                        Texto regular para contenido del cuerpo. Este es el tamaño y peso de fuente predeterminado para la mayoría del contenido de texto en la aplicación.
                    </p>
                    <p class="neo-text text-neo-gray">
                        Texto secundario en gris para información adicional o menos importante.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Shadows & Effects Section -->
    <section class="neo-section bg-white border-b-neo-extra border-neo-black">
        <div class="neo-container">
            <h2 class="neo-heading neo-h2 text-center mb-12">Sombras y Efectos</h2>

            <div class="grid md:grid-cols-3 gap-8">
                <!-- Shadow Sizes -->
                <div>
                    <h3 class="neo-heading neo-h4 mb-6">Tamaños de Sombra</h3>
                    <div class="space-y-6">
                        <div class="bg-white neo-border p-6 neo-shadow-sm">
                            <p class="neo-text-bold">Small Shadow</p>
                            <code class="neo-text text-xs">4px 4px 0px</code>
                        </div>
                        <div class="bg-white neo-border p-6 neo-shadow-md">
                            <p class="neo-text-bold">Medium Shadow</p>
                            <code class="neo-text text-xs">6px 6px 0px</code>
                        </div>
                        <div class="bg-white neo-border p-6 neo-shadow-lg">
                            <p class="neo-text-bold">Large Shadow</p>
                            <code class="neo-text text-xs">8px 8px 0px</code>
                        </div>
                    </div>
                </div>

                <!-- Colored Shadows -->
                <div>
                    <h3 class="neo-heading neo-h4 mb-6">Sombras de Color</h3>
                    <div class="space-y-6">
                        <div class="bg-white neo-border p-6 neo-shadow-flame">
                            <p class="neo-text-bold">Flame Shadow</p>
                            <code class="neo-text text-xs text-neo-flame">#cf5c36</code>
                        </div>
                        <div class="bg-white neo-border p-6 neo-shadow-sunset">
                            <p class="neo-text-bold">Sunset Shadow</p>
                            <code class="neo-text text-xs text-neo-sunset-dark">#efc88b</code>
                        </div>
                        <div class="bg-white neo-border p-6 neo-shadow-gray">
                            <p class="neo-text-bold">Gray Shadow</p>
                            <code class="neo-text text-xs text-neo-gray">#7c7c7c</code>
                        </div>
                    </div>
                </div>

                <!-- Transforms -->
                <div>
                    <h3 class="neo-heading neo-h4 mb-6">Transformaciones</h3>
                    <div class="space-y-6">
                        <div class="bg-neo-sunset neo-border p-6 neo-shadow-md neo-rotate-2">
                            <p class="neo-text-bold">Rotate +2°</p>
                        </div>
                        <div class="bg-neo-flame text-white neo-border p-6 neo-shadow-md neo-rotate-minus-1">
                            <p class="neo-text-bold text-white">Rotate -1°</p>
                        </div>
                        <div class="bg-neo-lavender-dark neo-border p-6 neo-shadow-md neo-skew">
                            <p class="neo-text-bold">Skew -2°</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Background Patterns Section -->
    <section class="neo-section neo-bg-grid border-b-neo-extra border-neo-black">
        <div class="neo-container">
            <h2 class="neo-heading neo-h2 text-center mb-12 bg-white inline-block px-6 py-3 neo-border neo-shadow-md mx-auto">
                Patrones de Fondo
            </h2>

            <div class="grid md:grid-cols-3 gap-8">
                <div class="neo-bg-dots neo-border neo-shadow-lg p-12 rounded-lg">
                    <div class="bg-white neo-border p-6 neo-shadow-md">
                        <p class="neo-text-bold text-center">Dots Pattern</p>
                    </div>
                </div>

                <div class="neo-bg-grid neo-border neo-shadow-lg p-12 rounded-lg">
                    <div class="bg-white neo-border p-6 neo-shadow-md">
                        <p class="neo-text-bold text-center">Grid Pattern</p>
                    </div>
                </div>

                <div class="neo-bg-stripes neo-border neo-shadow-lg p-12 rounded-lg">
                    <div class="bg-white neo-border p-6 neo-shadow-md">
                        <p class="neo-text-bold text-center">Stripes Pattern</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer CTA -->
    <section class="neo-section bg-neo-black text-white">
        <div class="neo-container text-center">
            <div class="inline-block neo-badge neo-badge-flame mb-6 rotate-[2deg]">
                COMIENZA GRATIS
            </div>

            <h2 class="neo-heading neo-h1 text-white mb-6">
                ¿Listo para revolucionar tu menú?
            </h2>

            <p class="neo-text neo-text-xl mb-12 text-white/80 max-w-2xl mx-auto">
                Únete a cientos de restaurantes que ya están usando MenuPlus para ofrecer una experiencia digital excepcional a sus clientes.
            </p>

            <div class="flex flex-wrap gap-6 justify-center">
                <Button variant="primary" size="lg" client:load>
                    Crear mi Menú
                </Button>
                <Button variant="white" size="lg" client:load>
                    Ver Pricing
                </Button>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-neo-black text-white border-t-neo-thick border-neo-flame py-8">
        <div class="neo-container text-center">
            <p class="neo-text text-white/60">
                © 2025 MenuPlus. Diseño Neobrutlista Ultra Estético.
            </p>
        </div>
    </footer>

</body>
</html>

<style>
    /* Smooth scroll behavior */
    html {
        scroll-behavior: smooth;
    }

    /* Custom utilities for this demo page */
    .rotate-\[1deg\] {
        transform: rotate(1deg);
    }

    .rotate-\[-1deg\] {
        transform: rotate(-1deg);
    }

    .rotate-\[2deg\] {
        transform: rotate(2deg);
    }

    .rotate-\[-2deg\] {
        transform: rotate(-2deg);
    }

    /* Grid auto-fit responsive */
    @media (max-width: 768px) {
        .neo-grid-3 {
            grid-template-columns: 1fr;
        }
    }
</style>
