---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Error - Menu Plus Platform">
  <main class="min-h-screen bg-neo-lavender flex flex-col items-center justify-center p-4 py-8 relative overflow-hidden">
    <!-- Animated Background Pattern -->
    <div class="absolute inset-0 neo-bg-grid-colorful opacity-15 pointer-events-none"></div>

    <div class="relative z-10 w-full max-w-md">
      <div class="neo-card-3d-sunset p-8 text-center">
        <!-- Error Icon -->
        <div class="mb-6">
          <span class="text-6xl">😕</span>
        </div>
        
        <h1 class="neo-heading neo-h3 mb-4">Enlace no válido</h1>
        <p class="neo-text text-lg mb-6" id="error-message">
          El enlace mágico ha expirado o ya fue utilizado.
        </p>
        
        <div class="space-y-3">
          <a href="/register" class="neo-btn neo-btn-primary w-full inline-flex items-center justify-center">
            🔮 Solicitar nuevo enlace
          </a>
          <a href="/login" class="neo-btn neo-btn-secondary w-full inline-flex items-center justify-center">
            Ir a Login
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  // Get error message from URL if provided
  const urlParams = new URLSearchParams(window.location.search);
  const message = urlParams.get('message');
  
  if (message) {
    const errorElement = document.getElementById('error-message');
    if (errorElement) {
      errorElement.textContent = decodeURIComponent(message);
    }
  }
</script>
