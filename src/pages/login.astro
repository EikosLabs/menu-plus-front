---
import Layout from "../layouts/Layout.astro";
import LoginForm from "../components/LoginForm.jsx";
---
<Layout title="Iniciar Sesión - Menu Plus Platform">
  <main class="min-h-screen bg-neo-lavender flex flex-col items-center justify-center p-4 relative overflow-hidden">
    <!-- Animated Background Pattern -->
    <div class="absolute inset-0 neo-bg-dots-colorful opacity-20 pointer-events-none"></div>

    <!-- Decorative Shapes -->
    <div class="absolute top-10 left-10 neo-shape-circle opacity-15 hidden lg:block" style="width: 60px; height: 60px;"></div>
    <div class="absolute bottom-10 right-10 neo-shape-square opacity-15 hidden lg:block" style="width: 60px; height: 60px;"></div>

    <div class="relative z-10 w-full max-w-md">
      <!-- Login Card 3D -->
      <div class="neo-card-3d p-6 md:p-8 neo-corner-accent">
        <!-- Logo -->
        <div class="text-center mb-4">
          <img src="/favicon.svg" alt="Menu Plus Platform Logo" class="w-16 mx-auto mb-3" />

          <!-- Badge -->
          <div class="inline-block neo-sticker neo-sticker-flame mb-2 text-sm">
            🔐 INICIAR SESIÓN
          </div>
        </div>

        <!-- Title -->
        <h1 class="neo-heading neo-h3 text-center mb-1">
          Bienvenido de Nuevo
        </h1>
        <p class="neo-text text-center text-neo-gray mb-5 text-sm">
          Accede a tu cuenta para gestionar tus menús.
        </p>

        <!-- Login Form -->
        <LoginForm client:load />

        <!-- Divider -->
        <div class="neo-divider my-5"></div>

        <!-- Register Link -->
        <div class="text-center">
          <p class="neo-text text-neo-gray mb-3 text-sm">
            ¿No tienes una cuenta?
          </p>
          <a
            href="/register"
            class="neo-btn neo-btn-secondary w-full inline-flex items-center justify-center"
          >
            Regístrate Gratis
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>
