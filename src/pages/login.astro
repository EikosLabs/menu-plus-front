---
import Layout from '../layouts/Layout.astro';
import LoginForm from '../components/LoginForm.jsx';
---
<Layout title="Iniciar Sesión - Menu Plus Platform">
  <main class="min-h-screen flex flex-col items-center justify-center p-6 animate-fade-in">
    <div class="bg-white text-[#0A3342] p-8 md:p-12 rounded-xl shadow-2xl w-full max-w-md">
      <img src="/logo-placeholder.svg" alt="Menu Plus Platform Logo" class="w-32 mx-auto mb-8" /> {/* Placeholder para tu logo */}
      <h1 class="text-4xl font-bold text-center text-[#004E71] mb-2">Bienvenido de Nuevo</h1>
      <p class="text-center text-slate-600 mb-10">Accede a tu cuenta para gestionar tus menús.</p>
      
      <LoginForm client:load />

      <div class="mt-8 text-center">
        <p class="text-sm text-slate-600">
          ¿No tienes una cuenta? 
          <a href="/register" class="font-medium text-[#E05C33] hover:underline">Regístrate Gratis</a>
        </p>
      </div>
    </div>
  </main>
</Layout> 