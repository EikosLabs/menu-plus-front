---
import { sanitizeUrl, validatePrice } from '../../utils/security.js';

const { item } = Astro.props;

const safeImageUrl = sanitizeUrl(item?.imageUri, '');
const safePrice = validatePrice(item?.price);
const isAvailable = item?.isAvailable !== false;
---

<div
  class={`menu-item ${!isAvailable ? 'menu-item--unavailable' : ''}`}
  data-item-id={item?.id}
  data-item-name={item?.name}
  data-item-price={safePrice}
  data-item-description={item?.description || ''}
  data-item-image={safeImageUrl}
  data-item-available={isAvailable}
  role="button"
  tabindex="0"
  aria-label={`View details for ${item?.name}`}
>
  <div class="menu-item__image-container">
    {safeImageUrl ? (
      <img
        src={safeImageUrl}
        alt={item?.name || 'Menu item'}
        class="menu-item__image"
        loading="lazy"
      />
    ) : (
      <div class="menu-item__image-placeholder">
        No Image
      </div>
    )}
    {!isAvailable && (
      <span class="menu-item__unavailable-tag">Unavailable</span>
    )}
  </div>

  <div class="menu-item__details">
    <div class="menu-item__header">
      <h3 class="menu-item__name">{item?.name || 'Unknown Item'}</h3>
      <span class="menu-item__price">${safePrice.toFixed(2)}</span>
    </div>
    {item?.description && (
      <p class="menu-item__description">{item.description}</p>
    )}
  </div>
</div>

<style>
  .menu-item {
    background: var(--surface-white, white);
    border-radius: var(--radius-lg, 16px);
    overflow: hidden;
    transition: all 0.3s ease;
    cursor: pointer;
    border: 1px solid var(--border-light, #E8E8E8);
    position: relative;
    animation: scaleIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
  }

  .menu-item:nth-child(1) { animation-delay: 0.05s; }
  .menu-item:nth-child(2) { animation-delay: 0.1s; }
  .menu-item:nth-child(3) { animation-delay: 0.15s; }
  .menu-item:nth-child(4) { animation-delay: 0.2s; }
  .menu-item:nth-child(5) { animation-delay: 0.25s; }
  .menu-item:nth-child(6) { animation-delay: 0.3s; }
  .menu-item:nth-child(n+7) { animation-delay: 0.35s; }

  .menu-item::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.05) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 1;
  }

  .menu-item:hover,
  .menu-item:focus {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
    border-color: var(--accent-gold, #D4AF37);
    outline: none;
  }

  .menu-item:hover::before,
  .menu-item:focus::before {
    opacity: 1;
  }

  .menu-item--unavailable {
    opacity: 0.7;
    filter: grayscale(0.8);
  }

  .menu-item--unavailable .menu-item__name,
  .menu-item--unavailable .menu-item__price {
    color: var(--unavailable-muted, #A0A0A0);
  }

  .menu-item__image-container {
    height: 240px;
    overflow: hidden;
    position: relative;
  }

  .menu-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .menu-item:hover .menu-item__image,
  .menu-item:focus .menu-item__image {
    transform: scale(1.05);
  }

  .menu-item__image-placeholder {
    background: linear-gradient(135deg, #f8f8f8 0%, #e8e8e8 100%);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-family: var(--font-display, serif);
    font-size: 1.2rem;
  }

  .menu-item__unavailable-tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--unavailable-muted, #A0A0A0);
    color: white;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-sm, 8px);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    z-index: 3;
  }

  .menu-item__details {
    padding: var(--spacing-lg, 2rem);
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .menu-item__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.5rem;
    gap: 1rem;
  }

  .menu-item__name {
    font-family: var(--font-display, serif);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--primary-dark, #0A0A0A);
    margin: 0;
    flex: 1;
  }

  .menu-item__price {
    font-family: var(--font-mono, monospace);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--accent-gold, #D4AF37);
    background: rgba(212, 175, 55, 0.1);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-sm, 8px);
    white-space: nowrap;
  }

  .menu-item__description {
    color: var(--text-secondary, #6B6B6B);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border-light, #E8E8E8);
  }

  @keyframes scaleIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (max-width: 768px) {
    .menu-item__image-container {
      height: 200px;
    }
  }
</style>
