---
const { sections = [], hasOtherItems = false } = Astro.props;
---

<nav class="category-nav" id="categoryNav">
  <div class="category-nav__scroll">
    {sections.map((section) => (
      <a href={`#section-${section.id}`} class="category-nav__link" data-section={`section-${section.id}`}>
        {section.name}
      </a>
    ))}
    {hasOtherItems && (
      <a href="#section-no-section" class="category-nav__link" data-section="section-no-section">
        Other Items
      </a>
    )}
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const categoryLinks = document.querySelectorAll('.category-nav__link');
    const sections = document.querySelectorAll('.menu-section');
    const navbar = document.getElementById('categoryNav');

    if (!categoryLinks.length || !sections.length) return;

    // Active link styling
    const updateActiveLink = (id) => {
      categoryLinks.forEach((link) => {
        const isActive = link.dataset.section === id;
        link.classList.toggle('active', isActive);

        if (isActive) {
          link.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });
    };

    // Intersection Observer for scroll spy
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            updateActiveLink(entry.target.id);
          }
        });
      },
      { rootMargin: '-20% 0px -60% 0px', threshold: 0 }
    );

    sections.forEach((section) => observer.observe(section));

    // Smooth scroll on click
    categoryLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = link.dataset.section;
        const targetSection = document.getElementById(targetId);

        if (targetSection && navbar) {
          const navbarHeight = navbar.offsetHeight;
          const targetPosition = targetSection.offsetTop - navbarHeight - 20;
          window.scrollTo({ top: targetPosition, behavior: 'smooth' });
        }
      });
    });
  });
</script>

<style>
  .category-nav {
    position: sticky;
    top: 1rem;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    border-radius: var(--radius-xl, 24px);
    margin: -4rem auto 0;
    max-width: 90%;
    padding: var(--spacing-sm, 1rem) var(--spacing-md, 1.5rem);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08), 0 2px 8px rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(212, 175, 55, 0.15);
    z-index: 100;
    transition: all 0.3s ease;
    animation: slideDown 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .category-nav:hover {
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12), 0 4px 12px rgba(0, 0, 0, 0.06);
    transform: translateY(-2px);
  }

  .category-nav__scroll {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.5rem;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .category-nav__scroll::-webkit-scrollbar {
    display: none;
  }

  .category-nav::before,
  .category-nav::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 40px;
    pointer-events: none;
    z-index: 2;
    transition: opacity 0.3s ease;
  }

  .category-nav::before {
    left: 0;
    background: linear-gradient(to right, rgba(255, 255, 255, 0.98), transparent);
    border-radius: var(--radius-xl, 24px) 0 0 var(--radius-xl, 24px);
  }

  .category-nav::after {
    right: 0;
    background: linear-gradient(to left, rgba(255, 255, 255, 0.98), transparent);
    border-radius: 0 var(--radius-xl, 24px) var(--radius-xl, 24px) 0;
  }

  .category-nav__link {
    font-family: var(--font-body, sans-serif);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary, #6B6B6B);
    text-decoration: none;
    padding: 0.625rem 1rem;
    border-radius: var(--radius-md, 12px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    letter-spacing: 0.02em;
    white-space: nowrap;
    flex-shrink: 0;
    background: transparent;
    border: 1px solid transparent;
    position: relative;
    overflow: hidden;
  }

  .category-nav__link::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.15), rgba(212, 175, 55, 0.05));
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: var(--radius-md, 12px);
  }

  .category-nav__link::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--accent-gold, #D4AF37);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform: translateX(-50%);
    border-radius: 2px;
  }

  .category-nav__link:hover,
  .category-nav__link.active {
    color: var(--primary-dark, #0A0A0A);
    transform: translateY(-2px);
    border-color: rgba(212, 175, 55, 0.2);
  }

  .category-nav__link:hover::before,
  .category-nav__link.active::before {
    opacity: 1;
  }

  .category-nav__link:hover::after,
  .category-nav__link.active::after {
    width: 80%;
  }

  .category-nav__link.active {
    font-weight: 600;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.2), rgba(212, 175, 55, 0.1));
    border-color: rgba(212, 175, 55, 0.3);
  }

  .category-nav__link:active {
    transform: translateY(0);
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-50px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .category-nav {
      margin: -3rem 0.5rem 0;
      padding: 0.5rem 1rem;
      top: 0.5rem;
      max-width: 95%;
      border-radius: var(--radius-lg, 16px);
    }

    .category-nav::before,
    .category-nav::after {
      display: none;
    }

    .category-nav__scroll {
      gap: 0.5rem;
      justify-content: flex-start;
      padding: 0.5rem 0;
    }

    .category-nav__link {
      font-size: 0.85rem;
      padding: 0.5rem 0.875rem;
    }
  }

  @media (max-width: 480px) {
    .category-nav {
      margin: -2rem 0.25rem 0;
      padding: 0.375rem 0.5rem;
    }

    .category-nav__link {
      font-size: 0.8rem;
      padding: 0.4rem 0.75rem;
    }
  }
</style>
