---
// Modal component for displaying item details
---

<div id="itemModal" class="item-modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="item-modal__content">
    <button class="item-modal__close" id="closeModal" aria-label="Close modal">&times;</button>

    <div class="item-modal__header">
      <h2 id="modalTitle" class="item-modal__title"></h2>
      <span id="modalPrice" class="item-modal__price"></span>
    </div>

    <div class="item-modal__body">
      <img id="modalImage" src="" alt="" class="item-modal__image" />
      <p id="modalDescription" class="item-modal__description"></p>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('itemModal');
  const closeBtn = document.getElementById('closeModal');
  const modalTitle = document.getElementById('modalTitle');
  const modalPrice = document.getElementById('modalPrice');
  const modalImage = document.getElementById('modalImage');
  const modalDescription = document.getElementById('modalDescription');

  const openModal = (data) => {
    if (!modal || !data) return;

    const { name, price, image, description } = data;

    modalTitle.textContent = name || 'Unknown Item';
    modalPrice.textContent = `$${parseFloat(price || 0).toFixed(2)}`;
    modalImage.src = image || '';
    modalImage.alt = name || 'Menu item';
    modalDescription.textContent = description || 'No description available.';

    modal.classList.add('show');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  };

  const closeModal = () => {
    if (!modal) return;

    modal.classList.remove('show');
    document.body.style.overflow = '';
  };

  // Event listeners
  closeBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  // Handle menu item clicks
  document.addEventListener('click', (e) => {
    const menuItem = e.target.closest('.menu-item');
    if (!menuItem) return;

    const data = {
      name: menuItem.dataset.itemName,
      price: menuItem.dataset.itemPrice,
      image: menuItem.dataset.itemImage,
      description: menuItem.dataset.itemDescription,
    };

    openModal(data);
  });

  // Handle keyboard navigation
  document.addEventListener('keydown', (e) => {
    const menuItem = e.target.closest('.menu-item');
    if (!menuItem || e.key !== 'Enter') return;

    const data = {
      name: menuItem.dataset.itemName,
      price: menuItem.dataset.itemPrice,
      image: menuItem.dataset.itemImage,
      description: menuItem.dataset.itemDescription,
    };

    openModal(data);
  });
</script>

<style>
  .item-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 1000;
    opacity: 0;
    transition: opacity 0.3s ease;
    align-items: center;
    justify-content: center;
  }

  .item-modal.show {
    display: flex;
    opacity: 1;
  }

  .item-modal__content {
    background: var(--surface-white, white);
    border-radius: var(--radius-xl, 24px);
    max-width: 600px;
    width: 90%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.3);
    animation: modalSlideIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes modalSlideIn {
    from {
      opacity: 0;
      transform: scale(0.9) translateY(20px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .item-modal__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(0, 0, 0, 0.05);
    border: none;
    font-size: 2rem;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary, #6B6B6B);
    z-index: 10;
    line-height: 1;
  }

  .item-modal__close:hover,
  .item-modal__close:focus {
    background: var(--accent-gold, #D4AF37);
    color: white;
    transform: rotate(90deg);
    outline: none;
  }

  .item-modal__header {
    padding: 3rem 2rem 1rem;
    border-bottom: 1px solid var(--border-light, #E8E8E8);
  }

  .item-modal__title {
    font-family: var(--font-display, serif);
    font-size: 2rem;
    color: var(--primary-dark, #0A0A0A);
    margin: 0 0 0.5rem 0;
    padding-right: 3rem;
  }

  .item-modal__price {
    font-family: var(--font-mono, monospace);
    font-size: 1.5rem;
    color: var(--accent-gold, #D4AF37);
    font-weight: 600;
  }

  .item-modal__body {
    padding: 2rem;
  }

  .item-modal__image {
    width: 100%;
    height: 300px;
    object-fit: cover;
    border-radius: var(--radius-md, 12px);
    margin-bottom: 1.5rem;
  }

  .item-modal__description {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-secondary, #6B6B6B);
    margin: 0;
  }

  @media (max-width: 768px) {
    .item-modal__content {
      width: 95%;
      max-height: 85vh;
      border-radius: var(--radius-lg, 16px);
    }

    .item-modal__title {
      font-size: 1.5rem;
    }

    .item-modal__image {
      height: 220px;
    }
  }

  @media (max-width: 480px) {
    .item-modal__image {
      height: 180px;
    }
  }
</style>
