---
import MenuItem from './MenuItem.astro';

const { section, items = [] } = Astro.props;
---

{items.length > 0 && (
  <section id={`section-${section?.id || 'no-section'}`} class="menu-section">
    <div class="menu-section__header">
      <h2 class="menu-section__title">{section?.name || 'Other Items'}</h2>
      {section?.description && (
        <p class="menu-section__description">{section.description}</p>
      )}
    </div>

    <div class="menu-section__grid">
      {items.map((item) => (
        <MenuItem item={item} />
      ))}
    </div>
  </section>
)}

<style>
  .menu-section {
    padding: 4rem 2rem;
    margin-bottom: 3rem;
    background: var(--surface-white, white);
    border-radius: var(--radius-xl, 24px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    border: 1px solid var(--border-light, #E8E8E8);
    animation: fadeInUp 0.8s ease-out;
  }

  .menu-section__header {
    text-align: center;
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-light, #E8E8E8);
  }

  .menu-section__title {
    font-family: var(--font-display, serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--primary-dark, #0A0A0A);
    position: relative;
    margin: 0 0 1rem 0;
  }

  .menu-section__title::after {
    content: '';
    position: absolute;
    bottom: -0.5rem;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 2px;
    background: var(--accent-gold, #D4AF37);
    transition: width 0.3s ease;
  }

  .menu-section__description {
    font-size: 1.1rem;
    color: var(--text-secondary, #6B6B6B);
    margin: 0;
    font-weight: 300;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .menu-section__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
    max-width: 100%;
  }

  @media (min-width: 769px) {
    .menu-section__grid {
      grid-template-columns: repeat(auto-fill, minmax(320px, 450px));
      justify-content: center;
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .menu-section {
      padding: 2rem 1.5rem;
      margin: 0 0.5rem 2rem;
      border-radius: var(--radius-lg, 16px);
    }

    .menu-section__grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .menu-section {
      padding: 1.5rem;
      margin: 0 0.25rem 1.5rem;
    }

    .menu-section__title {
      font-size: 1.75rem;
    }
  }
</style>
